---
import { RiBookOpenLine, RiGroupLine, RiUserAddLine } from 'react-icons/ri';

const items = [
  {
    Icon: RiBookOpenLine,
    title: 'Educate',
    desc: 'We make climate knowledge accessible, relevant, and beginner-friendly.',
  },
  {
    Icon: RiGroupLine,
    title: 'Empower',
    desc: 'We help youth turn awareness into real opportunities and impact.',
  },
  {
    Icon: RiUserAddLine,
    title: 'Connect',
    desc: "We strengthen Nepal's climate community by connecting people and organizations.",
  },
];
---

<section class="what-we-do-section">
  <div class="section-container what-we-do-inner">
    <h2 class="section-title">
      We help the youth discover, connect, and act on climate issues.
    </h2>

    <div class="grid">
      {
        items.map(({ Icon, ...item }) => (
          <div class="item">
            <div class="icon-circle">
              <Icon aria-hidden="true" size={16} />
            </div>
            <p class="item-title">{item.title}</p>
            <p class="item-desc">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .what-we-do-section {
    background-color: #f8f9fa;
    padding: 48px;
  }

  .what-we-do-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 48px;
    align-items: center;
  }

  .section-title {
    font-size: 26px;
    line-height: 32px;
    font-weight: 700;
    color: #1a1b1e;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .icon-circle {
    width: 36px;
    height: 36px;
    background-color: #cefe00;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
  }

  .icon-circle :global(svg) {
    color: #1a1b1e;
  }

  .item-title {
    font-size: 16px;
    font-weight: 700;
    color: #1a1b1e;
    margin: 0;
  }

  .item-desc {
    font-size: 14px;
    line-height: 22px;
    color: #464646;
    margin: 0;
  }

  @media (max-width: 1280px) {
    .what-we-do-section {
      padding: 40px 24px;
    }
  }

  @media (max-width: 1024px) {
    .what-we-do-inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 768px) {
    .what-we-do-section {
      padding: 32px 24px;
    }

    .section-title {
      font-size: 22px;
      line-height: 30px;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
