---
import youtubePlayButton from '../assets/youtube-play-button.png';
import '../styles/global.css';
---

<div class="section-container">
  <div class="content-section">
    <p class="tagline">
      A centralized knowledge hub to inspire collective climate action.
    </p>
    <a class="cta-button" href="/organizations">Find Organizations</a>
  </div>

  <div class="video-section">
    <h3 class="video-title">
      UN Chief calls for climate action from Mt. Everest
    </h3>
    <div class="video">
      <a
        class="video-facade"
        href="https://www.youtube.com/watch?v=bN3gVb__tmA"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Play UN Chief calls for climate action from Mt. Everest"
      >
        <img
          class="video-thumbnail"
          src="https://i.ytimg.com/vi/bN3gVb__tmA/mqdefault.jpg"
          alt=""
          width="320"
          height="180"
          loading="lazy"
          decoding="async"
        />
        <img
          class="play-icon"
          src={youtubePlayButton.src}
          alt=""
          width="48"
          height="48"
        />
      </a>
    </div>
    <p class="description">
      “The world cannot wait!” –UN chief, Antonio Guterres from the base of Mt.
      Everest, on the terrible impact of the climate crisis on the Himalayas.
    </p>
  </div>
</div>

<script>
  const videoFacade = document.querySelector<HTMLAnchorElement>('.video-facade');
  const videoContainer = videoFacade?.closest<HTMLElement>('.video');

  videoFacade?.addEventListener('click', (event) => {
    event.preventDefault();

    if (!videoContainer || videoContainer.classList.contains('is-loading')) {
      return;
    }

    videoContainer.classList.add('is-loading');

    const iframe = document.createElement('iframe');
    iframe.className = 'video-iframe';
    iframe.src =
      'https://www.youtube-nocookie.com/embed/bN3gVb__tmA?autoplay=1';
    iframe.title = 'UN Chief calls for climate action from Mt. Everest';
    iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen';
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.allowFullscreen = true;

    iframe.addEventListener('load', () => {
      window.setTimeout(() => {
        videoContainer.classList.add('is-player-ready');
        videoFacade.tabIndex = -1;
        videoFacade.setAttribute('aria-hidden', 'true');
      }, 300);
    });

    videoContainer.append(iframe);
  });
</script>

<style>
  .section-container {
    margin: 53px auto 83px;
    display: flex;
    gap: 28px;
  }

  .content-section {
    width: 45%;
    border-bottom: 1px solid #cefe00;
    padding-bottom: 32px;
  }

  .content-section .tagline {
    font-size: 30px;
    font-weight: 700;
    line-height: 36px;
    font-family: "Zilla Slab", serif;
    margin-bottom: 24px;
  }

  .cta-button {
    background-color: #1a1b1e;
    padding: 8px 16px;
    border-radius: 16px;
    text-decoration: none;
    font-size: 14px;
    line-height: 16px;
    font-weight: 400;
    color: white;
    display: inline-block;
    transition: all 0.1s ease-in-out;
  }

  .cta-button:hover {
    background-color: #cefe00;
    color: #25262b;
  }

  .video-section {
    width: 55%;
    display: grid;
    grid-template-rows: auto 1fr;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "video title" "video description";
    grid-gap: 0px 16px;
    min-height: 180px;
  }

  .video {
    display: block;
    position: relative;
    border-radius: 16px;
    grid-area: video;
    align-self: start;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-width: 0;
    overflow: hidden;
  }

  .video-facade,
  :global(.video-iframe) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 16px;
    border: none;
  }

  .video-facade {
    z-index: 1;
    min-width: 0;
    overflow: hidden;
    background: #1a1b1e;
    opacity: 1;
    transition: opacity 120ms ease-out;
  }

  :global(.video-iframe) {
    opacity: 0;
  }

  .video.is-player-ready .video-facade {
    pointer-events: none;
    opacity: 0;
  }

  .video.is-player-ready :global(.video-iframe) {
    opacity: 1;
  }

  .video-facade:focus-visible {
    outline: 3px solid #364fc7;
    outline-offset: -3px;
  }

  .video-thumbnail {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 48px;
    height: 48px;
    transform: translate(-50%, -50%);
  }

  .video-title {
    font-size: 24px;
    line-height: 32px;
    font-weight: bold;
    grid-area: title;
  }

  .video-section .description {
    font-size: 12px;
    font-weight: 400px;
    line-height: 14px;
    grid-area: description;
    width: 85%;
    margin-top: 12px;
  }

  @media screen and (max-width: 1180px) {
    .video-section {
      display: flex;
      flex-direction: column;
    }

    .video {
      width: 100%;
      margin: 0 auto;
      height: auto;
      margin-bottom: 12px;
    }

    .video-title {
      margin-bottom: 12px;
    }

    .video-section .description {
      width: 100%;
    }
  }

  @media screen and (max-width: 768px) {
    .section-container {
      margin: 24px 32px 64px;
      flex-direction: column;
    }

    .content-section,
    .video-section {
      width: 100%;
    }

    .video {
      max-width: 100%;
    }
  }
</style>
