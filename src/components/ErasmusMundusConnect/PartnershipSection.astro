---
interface Partner {
  id: string;
  name: string;
  location: string;
}

const inPartnershipWith: Partner[] = [
  {
    id: "partner-1",
    name: "Your Organization Name",
    location: "Location",
  },
  {
    id: "partner-2",
    name: "Your Organization Name",
    location: "Location",
  },
];

const supportedBy: Partner[] = [
  {
    id: "supporter-1",
    name: "Your Organization Name",
    location: "Location",
  },
  {
    id: "supporter-2",
    name: "Your Organization Name",
    location: "Location",
  },
];

const communityPartners: Partner[] = [
  {
    id: "community-1",
    name: "Your Organization Name",
    location: "Location",
  },
  {
    id: "community-2",
    name: "Your Organization Name",
    location: "Location",
  },
];
---

<div class="partnership-section">
  <div class="partnership-container">
    <h2 class="section-title">In partnership with</h2>

    <div class="cards-container">
      {
        inPartnershipWith.map((partner) => (
          <div class="partner-card">
            <div class="logo-container">
              <p class="logo-placeholder">Organization Logo</p>
            </div>
            <h4 class="organization-name">{partner.name}</h4>
            <p class="organization-location">{partner.location}</p>
          </div>
        ))
      }
    </div>

    <h2 class="section-title supported-title">Supported by</h2>

    <div class="cards-container">
      {
        supportedBy.map((partner) => (
          <div class="partner-card">
            <div class="logo-container">
              <p class="logo-placeholder">Organization Logo</p>
            </div>
            <h4 class="organization-name">{partner.name}</h4>
            <p class="organization-location">{partner.location}</p>
          </div>
        ))
      }
    </div>

    <h2 class="section-title community-title">Community partners</h2>

    <div class="cards-container">
      {
        communityPartners.map((partner) => (
          <div class="partner-card">
            <div class="logo-container">
              <p class="logo-placeholder">Organization Logo</p>
            </div>
            <h4 class="organization-name">{partner.name}</h4>
            <p class="organization-location">{partner.location}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .partnership-section {
    background: #ffffff;
    width: 100%;
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    margin-bottom: 64px;
  }

  .partnership-container {
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    max-width: 1280px;
    width: 100%;
  }

  .section-title {
    font-family: "Zilla Slab", serif;
    font-weight: 700;
    font-size: 32px;
    line-height: 130%;
    color: #1a1b1e;
    margin: 0;
    margin-bottom: 24px;
    text-align: center;
  }

  .supported-title,
  .community-title {
    margin-top: 40px;
    font-size: 26px;
  }

  .cards-container {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
    /* margin-bottom: 44px; */
  }

  .partner-card {
    max-width: 280px;
    width: 100%;
    border-radius: 16px;
    background-color: #ebf1f7;
    padding: 16px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease;
  }

  .partner-card:hover {
    transform: translateY(-2px);
  }

  .logo-container {
    width: 100%;
    height: 110px;
    margin-bottom: 14px;
    border-radius: 8px;
    overflow: hidden;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-placeholder {
    color: #364fc7;
    font-family: Roboto, sans-serif;
    font-weight: 500;
    font-size: 16px;
    margin: 0;
  }

  .organization-name {
    font-family: Roboto, sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 130%;
    color: #1a1b1e;
    margin: 0;
    margin-bottom: 4px;
  }

  .organization-location {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 130%;
    color: #5a5b5e;
    margin: 0;
  }

  /* Tablet */
  @media screen and (max-width: 1024px) {
    .partnership-section {
      margin-bottom: 48px;
    }

    .section-title {
      font-size: 28px;
      margin-bottom: 20px;
    }

    .supported-title,
    .community-title {
      margin-top: 32px;
      font-size: 22px;
    }

    .cards-container {
      margin-bottom: 36px;
    }

    .partner-card {
      max-width: 260px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 560px) {
    .partnership-section {
      margin-bottom: 36px;
    }

    .section-title {
      font-size: 24px;
      line-height: 130%;
      margin-bottom: 16px;
    }

    .supported-title,
    .community-title {
      margin-top: 24px;
      font-size: 20px;
    }

    .cards-container {
      gap: 16px;
      margin-bottom: 32px;
      flex-direction: column;
      align-items: center;
    }

    .partner-card {
      max-width: 100%;
      width: 100%;
    }

    .logo-container {
      height: 100px;
      margin-bottom: 12px;
    }

    .organization-name {
      font-size: 16px;
      margin-bottom: 3px;
    }

    .organization-location {
      font-size: 13px;
    }
  }

  @media screen and (max-width: 560px) {
    .partnership-section {
      padding: 40px 0;
    }

    .section-title {
      font-size: 20px;
      margin-bottom: 16px;
    }

    .supported-title,
    .community-title {
      margin-top: 24px;
    }

    .cards-container {
      margin-bottom: 24px;
    }

    .partner-card {
      padding: 12px;
    }

    .logo-container {
      height: 90px;
    }
  }
</style>
