---
import { impactStats, lastEditionImpactData } from "../../content/erasmus";
---

<div class="impact-section">
  <div class="impact-container">
    <h2 class="section-title">{lastEditionImpactData.title}</h2>

    <p class="section-subtitle">
      {lastEditionImpactData.subtitle}
    </p>

    <div class="stats-grid">
      {
        impactStats.map((stat) => (
          <div class="stat-item">
            <span class="stat-number">{stat.number}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .impact-section {
    background-color: #ebf1f7;
    width: 100%;
    padding: 62px 0;
  }

  .impact-container {
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    max-width: 1280px;
    width: 100%;
  }

  .section-title {
    font-family: Roboto, sans-serif;
    font-weight: 600;
    font-size: 40px;
    line-height: 50px;
    letter-spacing: -0.96px;
    color: #1a1b1e;
    margin: 0;
    margin-bottom: 20px;
  }

  .section-subtitle {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 150%;
    color: #1a1b1e;
    margin: 0;
    margin-bottom: 40px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .stat-item {
    background-color: #292a2c;
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: 0 2px 8px rgba(26, 27, 30, 0.08);
  }

  .stat-number {
    color: #cefe00;
    font-family: Roboto, sans-serif;
    font-size: 52px;
    font-weight: 600;
    line-height: 1;
  }

  .stat-label {
    color: #a8a8a8;
    font-family: Roboto, sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 140%;
  }

  /* Tablet */
  @media screen and (max-width: 1024px) {
    .impact-section {
      padding: 48px 0;
    }

    .section-title {
      font-size: 32px;
      line-height: 40px;
      margin-bottom: 16px;
    }

    .section-subtitle {
      font-size: 15px;
      margin-bottom: 32px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .stat-number {
      font-size: 44px;
    }

    .stat-label {
      font-size: 16px;
    }

    .stat-item {
      padding: 20px;
      gap: 16px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .impact-section {
      padding: 40px 0;
    }

    .section-title {
      font-size: 28px;
      line-height: 28px;
      margin-bottom: 12px;
    }

    .section-subtitle {
      font-size: 14px;
      margin-bottom: 28px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .stat-number {
      font-size: 36px;
    }

    .stat-label {
      font-size: 14px;
    }

    .stat-item {
      padding: 16px;
      gap: 12px;
    }
  }

  @media screen and (max-width: 560px) {
    .impact-section {
      padding: 32px 0;
    }

    .section-title {
      font-size: 24px;
      line-height: 24px;
      margin-bottom: 10px;
    }

    .section-subtitle {
      font-size: 13px;
      margin-bottom: 24px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .stat-number {
      font-size: 32px;
    }

    .stat-label {
      font-size: 13px;
    }

    .stat-item {
      padding: 16px;
      gap: 12px;
      flex-direction: row;
      align-items: center;
    }

    .stat-number {
      min-width: 60px;
    }
  }
</style>
