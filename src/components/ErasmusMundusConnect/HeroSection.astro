---
import { hero } from "../../assets/erasmus/images";
import { heroData } from "../../content/erasmus";
---

<div class="hero-section">
  <div class="hero-left">
    {/* Badge */}
    <div class="badge">
      <span class="badge-dot"></span>
      <span class="badge-text">{heroData.badge}</span>
    </div>

    {/* Title */}
    <h1 class="hero-title">{heroData.title}</h1>

    {/* Subtitle */}
    <p class="hero-subtitle">
      {heroData.subtitle}
    </p>

    {/* Button */}
    <button class="cta-button">{heroData.buttonText}</button>

    {/* Info Container */}
    <div class="info-container">
      {heroData.infoItems.map((item) => (
        <div class="info-item">
          <div class="info-header">
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M6.66667 1.66667C7.1269 1.66667 7.5 2.03976 7.5 2.5V3.33333H12.5V2.5C12.5 2.03976 12.8731 1.66667 13.3333 1.66667C13.7936 1.66667 14.1667 2.03976 14.1667 2.5V3.33333H15C16.3807 3.33333 17.5 4.45262 17.5 5.83333V15.8333C17.5 17.214 16.3807 18.3333 15 18.3333H5C3.61929 18.3333 2.5 17.214 2.5 15.8333V5.83333C2.5 4.45262 3.61929 3.33333 5 3.33333H5.83333V2.5C5.83333 2.03976 6.20643 1.66667 6.66667 1.66667ZM5.83333 5H5C4.53976 5 4.16667 5.3731 4.16667 5.83333V8.33333H15.8333V5.83333C15.8333 5.3731 15.4602 5 15 5H14.1667V5.83333C14.1667 6.29357 13.7936 6.66667 13.3333 6.66667C12.8731 6.66667 12.5 6.29357 12.5 5.83333V5H7.5V5.83333C7.5 6.29357 7.1269 6.66667 6.66667 6.66667C6.20643 6.66667 5.83333 6.29357 5.83333 5.83333V5ZM15.8333 10H4.16667V15.8333C4.16667 16.2936 4.53976 16.6667 5 16.6667H15C15.4602 16.6667 15.8333 16.2936 15.8333 15.8333V10ZM8.33333 12.5C8.33333 12.0398 8.70643 11.6667 9.16667 11.6667H10C10.4602 11.6667 10.8333 12.0398 10.8333 12.5V15C10.8333 15.4602 10.4602 15.8333 10 15.8333C9.53976 15.8333 9.16667 15.4602 9.16667 15V13.3333C8.70643 13.3333 8.33333 12.9602 8.33333 12.5Z"
                fill="#1A1B1E"
                fill-opacity="0.7"
              ></path>
            </svg>
            <div class="info-label">{item.label}</div>
          </div>
          <div class="info-value">{item.value}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="hero-right">
    <img src={hero.src} alt="Erasmus Mundus Connect" />
  </div>
</div>

<style>
  .hero-section {
    background: #ffffff;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 66px;
    margin: 0 auto;
    align-items: stretch;
    justify-content: space-between;
    margin-top: 22px;
    margin-bottom: 72px;
    max-width: 1280px;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #ebf1f7;
    border-radius: 15px;
    width: fit-content;
    margin-bottom: 12px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #364fc7;
  }

  .badge-text {
    font-family: Roboto, sans-serif;
    font-weight: 700;
    font-size: 12px;
    line-height: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #364fc7;
  }

  .hero-title {
    font-family: "Zilla Slab", serif;
    font-weight: 700;
    font-size: 36px;
    line-height: 36px;
    color: #000000;
    margin: 0;
    margin-bottom: 12px;
    max-width: 500px;
  }

  .hero-subtitle {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 140%;
    color: #1a1b1e;
    margin: 0;
    margin-bottom: 32px;
    max-width: 500px;
  }

  .cta-button {
    align-self: flex-start;
    padding: 12px 16px;
    border: none;
    border-radius: 21px;
    background: #cefe00;
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 16px;
    color: #1a1b1e;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-bottom: 36px;
  }

  .cta-button:hover {
    background: #b8e600;
    transform: translateY(-2px);
  }

  .info-container {
    display: flex;
    justify-content: space-between;
    border-radius: 16px;
    background: #ebf1f7;
    padding: 24px;
  }

  .info-item:last-child {
    padding-bottom: 0;
  }

  .info-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .info-header svg {
    flex-shrink: 0;
  }

  .info-label {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 100%;
    color: #1a1b1e;
    opacity: 0.7;
  }

  .info-value {
    font-family: Roboto, sans-serif;
    font-weight: 500;
    font-size: 18px;
    line-height: 100%;
    color: #1a1b1e;
  }

  .hero-right {
    overflow: hidden;
    border-radius: 24px;
    background-color: red;
    position: relative;
  }

  .hero-right img {
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
  }

  /* Tablet */
  @media screen and (max-width: 1024px) {
    .hero-section {
      margin-bottom: 58px;
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero-right {
      order: -1;
      border-radius: 12px;
      height: 300px;
    }

    .hero-image-placeholder {
      aspect-ratio: 2/1;
    }

    .hero-title {
      font-size: 28px;
      line-height: 28px;
      max-width: 100%;
    }

    .hero-subtitle {
      font-size: 18px;
      max-width: 100%;
    }
  }

  /* Large phones / small tablets */
  @media screen and (max-width: 768px) {
    .hero-section {
      margin-bottom: 48px;
      grid-template-columns: 1fr;
    }

    .hero-title {
      font-size: 24px;
      line-height: 24px;
    }

    .hero-subtitle {
      font-size: 16px;
      margin-bottom: 24px;
    }

    .info-container {
      padding: 16px;
    }

    .info-header {
      gap: 6px;
    }

    .info-label {
      font-size: 14px;
    }

    .info-value {
      font-size: 16px;
    }
  }

  /* Phones */
  @media screen and (max-width: 560px) {
    .hero-section {
      margin-bottom: 36px;
    }

    .hero-right {
      height: 200px;
    }

    .badge {
      padding: 6px 10px;
      gap: 8px;
    }

    .badge-text {
      font-size: 11px;
    }

    .hero-title {
      font-size: 20px;
      line-height: 20px;
      margin-bottom: 8px;
    }

    .hero-subtitle {
      font-size: 14px;
      margin-bottom: 16px;
    }

    .cta-button {
      padding: 10px 14px;
      font-size: 14px;
      margin-bottom: 24px;
    }

    .info-container {
      padding: 12px;
      gap: 12px;
    }

    .info-header {
      gap: 4px;
    }

    .info-header svg {
      width: 16px;
      height: 16px;
    }

    .info-label {
      font-size: 12px;
    }

    .info-value {
      font-size: 14px;
    }
  }

  @media screen and (max-width: 380px) {
    .info-container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
