        </div>
        <div class="info-value">8+</div>
      </div>

      <div class="info-item">
        <div class="info-header">
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M10 3.33358C8.84629 3.33358 7.71849 3.67569 6.75921 4.31665C5.79993 4.95761 5.05225 5.86863 4.61073 6.93452C4.16921 8.0004 4.05368 9.17328 4.27873 10.3048C4.50378 11.4363 5.05929 12.4757 5.87502 13.2915C5.87505 13.2915 5.87499 13.2915 5.87502 13.2915L9.41146 16.8271C9.56772 16.9832 9.77955 17.0709 10.0004 17.0709C10.2213 17.0709 10.4331 16.9832 10.5894 16.8271L14.1249 13.2916C14.1249 13.2916 14.1249 13.2916 14.1249 13.2916C14.9407 12.4758 15.4962 11.4364 15.7213 10.3048C15.9463 9.17328 15.8308 8.0004 15.3893 6.93452C14.9478 5.86863 14.2001 4.95761 13.2408 4.31665C12.2815 3.67569 11.1537 3.33358 10 3.33358ZM5.83327 2.93086C7.06663 2.10677 8.51666 1.66691 10 1.66691C11.4833 1.66691 12.9334 2.10677 14.1667 2.93086C15.4001 3.75495 16.3614 4.92627 16.9291 6.29669C17.4967 7.66712 17.6453 9.1751 17.3559 10.6299C17.0666 12.0848 16.3523 13.4212 15.3034 14.4701L11.7676 18.0059C11.2988 18.4742 10.663 18.7376 10.0004 18.7376C9.33782 18.7376 8.70231 18.4745 8.23355 18.0062L4.69665 14.4702C3.6478 13.4212 2.93344 12.0848 2.64409 10.6299C2.35473 9.1751 2.50328 7.66712 3.07094 6.29669C3.63861 4.92627 4.59991 3.75495 5.83327 2.93086ZM10 7.5C9.07953 7.5 8.33333 8.24619 8.33333 9.16667C8.33333 10.0871 9.07953 10.8333 10 10.8333C10.9205 10.8333 11.6667 10.0871 11.6667 9.16667C11.6667 8.24619 10.9205 7.5 10 7.5ZM6.66667 9.16667C6.66667 7.32572 8.15905 5.83333 10 5.83333C11.8409 5.83333 13.3333 7.32572 13.3333 9.16667C13.3333 11.0076 11.8409 12.5 10 12.5C8.15905 12.5 6.66667 11.0076 6.66667 9.16667Z"
              fill="#1A1B1E"
              fill-opacity="0.7"></path>
          </svg>
          <div class="info-label">Location</div>
        </div>
        <div class="info-value">Virtual</div>
      </div>
    </div>
  </div>

  <div class="hero-right">
    <img src={hero.src} alt="Erasmus Mundus Connect" />
  </div>
</div>

<style>
  .hero-section {
    background: #ffffff;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 66px;
    margin: 0 auto;
    align-items: stretch;
    justify-content: space-between;
    margin-top: 22px;
    margin-bottom: 72px;
    max-width: 1280px;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #ebf1f7;
    border-radius: 15px;
    width: fit-content;
    margin-bottom: 12px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #364fc7;
  }

  .badge-text {
    font-family: Roboto, sans-serif;
    font-weight: 700;
    font-size: 12px;
    line-height: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #364fc7;
  }

  .hero-title {
    font-family: "Zilla Slab", serif;
    font-weight: 700;
    font-size: 36px;
    line-height: 36px;
    color: #000000;
    margin: 0;
    margin-bottom: 12px;
    max-width: 500px;
  }

  .hero-subtitle {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 140%;
    color: #1a1b1e;
    margin: 0;
    margin-bottom: 32px;
    max-width: 500px;
  }

  .cta-button {
    align-self: flex-start;
    padding: 12px 16px;
    border: none;
    border-radius: 21px;
    background: #cefe00;
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 16px;
    color: #1a1b1e;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-bottom: 36px;
  }

  .cta-button:hover {
    background: #b8e600;
    transform: translateY(-2px);
  }

  .info-container {
    display: flex;
    justify-content: space-between;
    border-radius: 16px;
    background: #ebf1f7;
    padding: 24px;
  }

  .info-item:last-child {
    padding-bottom: 0;
  }

  .info-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .info-header svg {
    flex-shrink: 0;
  }

  .info-label {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 100%;
    color: #1a1b1e;
    opacity: 0.7;
  }

  .info-value {
    font-family: Roboto, sans-serif;
    font-weight: 500;
    font-size: 18px;
    line-height: 100%;
    color: #1a1b1e;
  }

  .hero-right {
    overflow: hidden;
    border-radius: 24px;
    background-color: red;
    position: relative;
  }

  .hero-right img {
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
  }

  /* Tablet */
  @media screen and (max-width: 1024px) {
    .hero-section {
      /* padding: 48px 0; */
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero-right {
      order: -1;
      border-radius: 12px;
      height: 300px;
    }

    .hero-image-placeholder {
      aspect-ratio: 2/1;
    }

    .hero-title {
      font-size: 28px;
      line-height: 28px;
      max-width: 100%;
    }

    .hero-subtitle {
      font-size: 18px;
      max-width: 100%;
    }
  }

  /* Large phones / small tablets */
  @media screen and (max-width: 768px) {
    .hero-section {
      /* padding: 40px 0; */
      grid-template-columns: 1fr;
    }

    .hero-title {
      font-size: 24px;
      line-height: 24px;
    }

    .hero-subtitle {
      font-size: 16px;
      margin-bottom: 24px;
    }

    .info-container {
      padding: 16px;
    }

    .info-header {
      gap: 6px;
    }

    .info-label {
      font-size: 14px;
    }

    .info-value {
      font-size: 16px;
    }
  }

  /* Phones */
  @media screen and (max-width: 560px) {
    .hero-section {
      /* padding: 24px 0; */
    }

    .hero-right {
      height: 200px;
    }

    .badge {
      padding: 6px 10px;
      gap: 8px;
    }

    .badge-text {
      font-size: 11px;
    }

    .hero-title {
      font-size: 20px;
      line-height: 20px;
      margin-bottom: 8px;
    }

    .hero-subtitle {
      font-size: 14px;
      margin-bottom: 16px;
    }

    .cta-button {
      padding: 10px 14px;
      font-size: 14px;
      margin-bottom: 24px;
    }

    .info-container {
      padding: 12px;
      gap: 12px;
    }

    .info-header {
      gap: 4px;
    }

    .info-header svg {
      width: 16px;
      height: 16px;
    }

    .info-label {
      font-size: 12px;
    }

    .info-value {
      font-size: 14px;
    }
  }

  @media screen and (max-width: 380px) {
    .info-container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
