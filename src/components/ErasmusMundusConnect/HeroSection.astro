---
import { hero } from "../../assets/erasmus/images";
---

<div class="hero-section">
  <div class="hero-left">
    {/* Badge */}
    <div class="badge">
      <span class="badge-dot"></span>
      <span class="badge-text">2nd edition</span>
    </div>

    {/* Title */}
    <h1 class="hero-title">Erasmus Mundus Connect Nepal 2026</h1>

    {/* Subtitle */}
    <p class="hero-subtitle">
      Empowering Nepalese students to access fully funded European education and
      bring global knowledge back to solve Nepal's climate, environmental,
      technological, and development challenges.
    </p>

    {/* Button */}
    <button class="cta-button">Registration opens soon</button>

    {/* Info Container */}
