---
import { scholarshipBenefitData } from "../../content/erasmus";
---

<div class="scholarship-section">
  <h2 class="section-title">{scholarshipBenefitData.title}</h2>

  <p class="section-subtitle">
    {scholarshipBenefitData.subtitle}
  </p>

  <h3 class="benefit-heading">{scholarshipBenefitData.heading}</h3>

  <div class="benefits-grid">
    {
      scholarshipBenefitData.benefits.map((benefit) => (
        <div class="benefit-item">
          <div class="icon-container">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M7 5C6.73478 5 6.48043 5.10536 6.29289 5.29289C6.10536 5.48043 6 5.73478 6 6V15.1716C6.3182 15.0591 6.65606 15 7 15H18V5H7ZM20 4C20 3.44772 19.5523 3 19 3H7C6.20435 3 5.44129 3.31607 4.87868 3.87868C4.31607 4.44129 4 5.20435 4 6V18C4 18.7956 4.31607 19.5587 4.87868 20.1213C5.44129 20.6839 6.20435 21 7 21H19C19.5523 21 20 20.5523 20 20V4ZM18 17H7C6.73478 17 6.48043 17.1054 6.29289 17.2929C6.10536 17.4804 6 17.7348 6 18C6 18.2652 6.10536 18.5196 6.29289 18.7071C6.48043 18.8946 6.73478 19 7 19H18V17ZM8 8C8 7.44772 8.44772 7 9 7H15C15.5523 7 16 7.44772 16 8C16 8.55228 15.5523 9 15 9H9C8.44772 9 8 8.55228 8 8Z"
                fill="#212529"
              />
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M7 5C6.73478 5 6.48043 5.10536 6.29289 5.29289C6.10536 5.48043 6 5.73478 6 6V15.1716C6.3182 15.0591 6.65606 15 7 15H18V5H7ZM20 4C20 3.44772 19.5523 3 19 3H7C6.20435 3 5.44129 3.31607 4.87868 3.87868C4.31607 4.44129 4 5.20435 4 6V18C4 18.7956 4.31607 19.5587 4.87868 20.1213C5.44129 20.6839 6.20435 21 7 21H19C19.5523 21 20 20.5523 20 20V4ZM18 17H7C6.73478 17 6.48043 17.1054 6.29289 17.2929C6.10536 17.4804 6 17.7348 6 18C6 18.2652 6.10536 18.5196 6.29289 18.7071C6.48043 18.8946 6.73478 19 7 19H18V17ZM8 8C8 7.44772 8.44772 7 9 7H15C15.5523 7 16 7.44772 16 8C16 8.55228 15.5523 9 15 9H9C8.44772 9 8 8.55228 8 8Z"
                fill="#F8F9FA"
              />
            </svg>
          </div>
          <p class="benefit-text">{benefit.text}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .scholarship-section {
    background: #ffffff;
    width: 100%;
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    padding: 72px 0;
    max-width: 1280px;
  }

  .section-title {
    font-family: Roboto, sans-serif;
    font-weight: 600;
    font-size: 36px;
    line-height: 100%;
    color: #000000;
    margin: 0;
    margin-bottom: 20px;
  }

  .section-subtitle {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 140%;
    color: #000000cc;
    margin: 0;
    margin-bottom: 40px;
  }

  .benefit-heading {
    font-family: "Zilla Slab", serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 22px;
    color: #000000;
    margin: 0;
    margin-bottom: 32px;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px 32px;
  }

  .benefit-item {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  .icon-container {
    width: 44px;
    height: 44px;
    background: #1a1b1e;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-container svg {
    width: 24px;
    height: 24px;
  }

  .benefit-text {
    font-family: Roboto, sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 22px;
    color: #000000cc;
    margin: 0;
  }

  /* Tablet */
  @media screen and (max-width: 1024px) {
    .scholarship-section {
      padding: 56px 0;
    }

    .section-title {
      font-size: 32px;
    }

    .section-subtitle {
      font-size: 20px;
    }

    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px 24px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .scholarship-section {
      padding: 48px 0;
    }

    .section-title {
      font-size: 28px;
      line-height: 28px;
      margin-bottom: 16px;
    }

    .section-subtitle {
      font-size: 18px;
      margin-bottom: 32px;
    }

    .benefit-heading {
      font-size: 20px;
      line-height: 20px;
      margin-bottom: 24px;
    }

    .benefits-grid {
      grid-template-columns: 1fr;
      gap: 16px 16px;
    }

    .benefit-text {
      font-size: 15px;
      line-height: 20px;
    }
  }

  @media screen and (max-width: 560px) {
    .scholarship-section {
      padding: 24px 0;
    }

    .section-title {
      font-size: 24px;
    }

    .section-subtitle {
      font-size: 16px;
      margin-bottom: 24px;
    }

    .benefit-heading {
      font-size: 18px;
      margin-bottom: 20px;
    }

    .benefit-item {
      gap: 12px;
    }

    .benefit-text {
      font-size: 14px;
      line-height: 18px;
    }
  }
</style>
