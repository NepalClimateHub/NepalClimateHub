---
interface Speaker {
  id: string;
  name: string;
  qualification: string;
  location: string;
  linkedinUrl: string;
  image: string;
}

const speakers: Speaker[] = [
  {
    id: "speaker-1",
    name: "will be updated soon",
    qualification: "will be updated soon",
    location: "will be updated soon",
    linkedinUrl: "https://linkedin.com/in/johnanderson",
    image: "https://placehold.co/400x400?text=Speaker+Image",
  },
  {
    id: "speaker-2",
    name: "will be updated soon",
    qualification: "will be updated soon",
    location: "will be updated soon",
    linkedinUrl: "https://linkedin.com/in/sarahchen",
    image: "https://placehold.co/400x400?text=Speaker+Image",
  },
  {
    id: "speaker-3",
    name: "will be updated soon",
    qualification: "will be updated soon",
    location: "will be updated soon",
    linkedinUrl: "https://linkedin.com/in/mariedubois",
    image: "https://placehold.co/400x400?text=Speaker+Image",
  },
  {
    id: "speaker-4",
    name: "will be updated soon",
    qualification: "will be updated soon",
    location: "will be updated soon",
    linkedinUrl: "https://linkedin.com/in/marcorossi",
    image: "https://placehold.co/400x400?text=Speaker+Image",
  },
];
---

<div class="speakers-section">
  <h2 class="section-title">Speakers</h2>

  <p class="section-subtitle">
    Speakers who have already been awarded the scholarship, no random talk, just
    practical, relatable experiences.
  </p>

  <div class="speakers-grid">
    {
      speakers.map((speaker) => (
        <div class="speaker-card">
          <div class="speaker-image">
            <img src={speaker.image} alt={speaker.name} />
          </div>

          <div class="card-content">
            <h3 class="speaker-name">{speaker.name}</h3>

            <p class="speaker-qualification">{speaker.qualification}</p>

            <div class="speaker-footer">
              <p class="speaker-location">{speaker.location}</p>

              {/* <a href={speaker.linkedinUrl} target="_blank" rel="noopener noreferrer" class="linkedin-link">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M6 5C5.44772 5 5 5.44772 5 6V18C5 18.5523 5.44772 19 6 19H18C18.5523 19 19 18.5523 19 18V6C19 5.44772 18.5523 5 18 5H6ZM3 6C3 4.34315 4.34315 3 6 3H18C19.6569 3 21 4.34315 21 6V18C21 19.6569 19.6569 21 18 21H6C4.34315 21 3 19.6569 3 18V6ZM8 7C8.55228 7 9 7.44772 9 8V8.01C9 8.56228 8.55228 9.01 8 9.01C7.44772 9.01 7 8.56228 7 8.01V8C7 7.44772 7.44772 7 8 7ZM8 10C8.55228 10 9 10.4477 9 11V16C9 16.5523 8.55228 17 8 17C7.44772 17 7 16.5523 7 16V11C7 10.4477 7.44772 10 8 10ZM11 16C11 16.5523 11.4477 17 12 17C12.5523 17 13 16.5523 13 16V13C13 12.7348 13.1054 12.4804 13.2929 12.2929C13.4804 12.1054 13.7348 12 14 12C14.2652 12 14.5196 12.1054 14.7071 12.2929C14.8946 12.4804 15 12.7348 15 13V16C15 16.5523 15.4477 17 16 17C16.5523 17 17 16.5523 17 16V13C17 12.2043 16.6839 11.4413 16.1213 10.8787C15.5587 10.3161 14.7957 10 14 10C13.5483 10 13.1071 10.1019 12.7071 10.2929C12.5261 10.1119 12.2761 10 12 10C11.4477 10 11 10.4477 11 11V16Z"
                    fill="currentColor"></path>
                </svg>
              </a> */}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .speakers-section {
    background: #ffffff;
    width: 100%;
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    padding: 72px 0;
    max-width: 1280px;
  }

  .section-title {
    font-family: "Zilla Slab", serif;
    font-weight: 700;
    font-size: 32px;
    line-height: 130%;
    color: #1a1b1e;
    margin: 0;
    margin-bottom: 12px;
  }

  .section-subtitle {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 150%;
    color: #4a4b4e;
    margin: 0;
    margin-bottom: 32px;
  }

  .speakers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .speaker-card {
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    padding-bottom: 4px;
  }

  .speaker-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    margin-bottom: 14px;
    border-radius: 12px;
    overflow: hidden;
  }

  .speaker-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    padding: 0;
  }

  .speaker-name {
    font-family: Roboto, sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 130%;
    color: #1a1b1e;
    margin: 0;
    margin-bottom: 4px;
  }

  .speaker-qualification {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 140%;
    color: #5a5b5e;
    margin: 0;
    margin-bottom: 8px;
  }

  .speaker-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .speaker-location {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 140%;
    color: #5a5b5e;
    margin: 0;
  }

  /* Tablet */
  @media screen and (max-width: 1024px) {
    .speakers-section {
      padding: 64px 0;
    }

    .section-title {
      font-size: 32px;
      line-height: 40px;
    }

    .speakers-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .speakers-section {
      padding: 56px 0;
    }

    .section-title {
      font-size: 28px;
      line-height: 130%;
    }

    .section-subtitle {
      font-size: 16px;
      margin-bottom: 24px;
    }

    .speakers-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 560px) {
    .speakers-section {
      padding: 36px 0;
    }

    .section-title {
      font-size: 24px;
      line-height: 130%;
      margin-bottom: 12px;
    }

    .section-subtitle {
      font-size: 15px;
      margin-bottom: 20px;
    }

    .speakers-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
