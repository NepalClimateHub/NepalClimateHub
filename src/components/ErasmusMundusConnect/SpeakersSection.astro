---
import { speakers } from "../../content/erasmus";
---

<div class="speakers-section">
  <h2 class="section-title">Speakers</h2>

  <p class="section-subtitle">
    Speakers who have already been awarded the scholarship, no random talk, just
    practical, relatable experiences.
  </p>

  <div class="speakers-grid">
    {
      speakers.map((speaker) => (
        <div class="speaker-card">
          <div class="speaker-image">
            <img src={speaker.image} alt={speaker.name} />
          </div>

          <div class="card-content">
            <h3 class="speaker-name">{speaker.name}</h3>

            <p class="speaker-qualification">{speaker.qualification}</p>

           <div class="speaker-footer">
              <p class="speaker-location">{speaker.location}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .speakers-section {
    background: #ffffff;
    width: 100%;
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    padding: 72px 0;
    max-width: 1280px;
  }

  .section-title {
    font-family: Roboto, sans-serif;
    font-weight: 600;
    font-size: 40px;
    line-height: 50px;
    letter-spacing: -0.96px;
    color: #1a1b1e;
    margin: 0;
    margin-bottom: 24px;
  }

  .section-subtitle {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 150%;
    color: #1a1b1e;
    margin: 0;
    margin-bottom: 40px;
  }

  .speakers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .speaker-card {
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    padding-bottom: 4px;
  }

  .speaker-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    margin-bottom: 16px;
    border-radius: 12px;
    overflow: hidden;
  }

  .speaker-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    padding: 0;
  }

  .speaker-name {
    font-family: Roboto, sans-serif;
    font-weight: 500;
    font-size: 18px;
    line-height: 100%;
    letter-spacing: -2%;
    color: #000000;
    margin: 0;
    margin-bottom: 4px;
  }

  .speaker-qualification {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: -1%;
    color: rgba(0, 0, 0, 0.7);
    margin: 0;
    margin-bottom: 12px;
    font-style: italic;
  }

  .speaker-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .speaker-location {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 100%;
    letter-spacing: -1%;
    color: rgba(0, 0, 0, 0.7);
    margin: 0;
    font-style: italic;
  }

  /* .linkedin-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: #000000;
    transition: color 0.3s ease;
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
  } */

  /* .linkedin-link:hover {
    color: #0a66c2;
  } */
  /* 
  .linkedin-link svg {
    width: 24px;
    height: 24px;
  } */

  /* Tablet */
  @media screen and (max-width: 1024px) {
    .speakers-section {
      padding: 64px 0;
    }

    .section-title {
      font-size: 32px;
      line-height: 40px;
    }

    .speakers-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .speakers-section {
      padding: 56px 0;
    }

    .section-title {
      font-size: 28px;
      line-height: 28px;
      margin-bottom: 16px;
    }

    .section-subtitle {
      font-size: 14px;
      margin-bottom: 32px;
    }

    .speakers-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .speaker-name {
      font-size: 16px;
    }

    .speaker-qualification {
      font-size: 13px;
    }

    .speaker-location {
      font-size: 13px;
    }
  }

  @media screen and (max-width: 560px) {
    .speakers-section {
      padding: 36px 0;
    }

    .section-title {
      font-size: 24px;
      line-height: 24px;
      margin-bottom: 12px;
    }

    .section-subtitle {
      font-size: 13px;
      margin-bottom: 24px;
    }

    .speaker-image {
      margin-bottom: 12px;
    }

    .speaker-name {
      font-size: 15px;
      margin-bottom: 3px;
    }

    .speaker-qualification {
      font-size: 12px;
      margin-bottom: 10px;
    }
  }
</style>
