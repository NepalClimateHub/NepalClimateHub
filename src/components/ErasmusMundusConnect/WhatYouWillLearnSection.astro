---
import { whatYouWillLearnData } from "../../content/erasmus";
---

<div class="learn-section">
  <div class="learn-container">
    <div class="learn-left">
      <h2 class="learn-title">{whatYouWillLearnData.title}</h2>
      <p class="learn-subtitle">
        {whatYouWillLearnData.subtitle}
      </p>
    </div>

    <div class="learn-right">
      {whatYouWillLearnData.items.map((item) => (
        <div class="learn-item">
          <span class="item-number">{item.number}</span>
          <p class="item-text">{item.text}</p>
        </div>
      ))}
    </div>
  </div>

  <p class="learn-footer">
    {whatYouWillLearnData.footer}
  </p>
</div>

<style>
  .learn-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    margin: 72px auto;
    max-width: 1280px;
  }

  .learn-container {
    display: flex;
    gap: 52px;
    margin-bottom: 40px;
    justify-content: space-between;
  }

  .learn-left {
    width: 359px;
    display: flex;
    flex-direction: column;
  }

  .learn-title {
    font-family: Roboto, sans-serif;
    font-weight: 600;
    font-size: 40px;
    line-height: 130%;
    color: #1a1b1e;
    margin: 0;
    margin-bottom: 20px;
  }

  .learn-subtitle {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 28px;
    color: #666666;
    margin: 0;
  }

  .learn-right {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .learn-item {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 12.63px 0;
    border-bottom: 1px solid #eaeaea;
  }

  .learn-item:first-child {
    border-top: 1px solid #eaeaea;
  }

  .item-number {
    font-family: "Zilla Slab", serif;
    font-weight: 700;
    font-size: 32px;
    line-height: 32px;
    color: #364fc7;
    flex-shrink: 0;
    min-width: 40px;
  }

  .item-text {
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 34px;
    color: #343232;
    margin: 0;
  }

  .learn-footer {
    font-family: "Zilla Slab", serif;
    font-weight: 600;
    font-style: italic;
    font-size: 24px;
    line-height: 28px;
    text-align: center;
    color: #1a1b1e;
    margin: 0;
  }

  /* Tablet */
  @media screen and (max-width: 1024px) {
    .learn-section {
      margin-top: 44px;
      margin-bottom: 44px;
    }

    .learn-container {
      flex-direction: column;
      gap: 32px;
    }

    .learn-left {
      width: 100%;
    }

    .learn-title {
      font-size: 32px;
    }

    .learn-subtitle {
      font-size: 18px;
    }

    .item-text {
      font-size: 20px;
      line-height: 28px;
    }

    .learn-footer {
      font-size: 20px;
      line-height: 24px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .learn-section {
      margin-top: 32px;
      margin-bottom: 32px;
    }

    .learn-container {
      flex-direction: column;
      gap: 24px;
      margin-bottom: 32px;
    }

    .learn-left {
      width: 100%;
    }

    .learn-title {
      font-size: 28px;
      line-height: 28px;
      margin-bottom: 16px;
    }

    .learn-subtitle {
      font-size: 16px;
      line-height: 24px;
    }

    .learn-item {
      gap: 16px;
      padding: 12px 0;
    }

    .item-number {
      font-size: 28px;
      line-height: 36px;
      min-width: 36px;
    }

    .item-text {
      font-size: 18px;
      line-height: 24px;
    }

    .learn-footer {
      font-size: 18px;
      line-height: 22px;
    }
  }

  @media screen and (max-width: 560px) {
    .learn-section {
      margin-top: 24px;
      margin-bottom: 24px;
    }

    .learn-container {
      margin-bottom: 24px;
    }

    .learn-title {
      font-size: 24px;
      margin-bottom: 12px;
    }

    .learn-subtitle {
      font-size: 14px;
      line-height: 20px;
    }

    .learn-item {
      gap: 12px;
      padding: 10px 0;
    }

    .item-number {
      font-size: 24px;
      line-height: 32px;
      min-width: 32px;
    }

    .item-text {
      font-size: 16px;
      line-height: 22px;
    }

    .learn-footer {
      font-size: 16px;
      line-height: 20px;
    }
  }
</style>
