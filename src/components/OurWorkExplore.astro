---
import { RiSearchLine } from 'react-icons/ri';
import type { Project } from 'src/types/project';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const order = ['ongoing', 'upcoming', 'completed'];
const statuses = [
  ...new Set(
    projects.map((p) => (p.status || '').toLowerCase().trim()).filter(Boolean)
  ),
].sort((a, b) => {
  const ia = order.indexOf(a);
  const ib = order.indexOf(b);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});
---

<section class="explore-section">
  <div class="section-container">
    <div class="explore-header">
      <div>
        <h2 class="section-title">Explore our Work</h2>
        <p class="section-description">
          Our ongoing, completed, and upcoming projects and initiatives
        </p>
      </div>

      <label class="search-box">
        <RiSearchLine aria-hidden="true" size={16} />
        <input
          type="search"
          id="work-search"
          placeholder="Search projects..."
          aria-label="Search projects"
        />
      </label>
    </div>

    {
      statuses.length > 1 && (
        <div class="filter-pills" role="tablist" aria-label="Filter by status">
          <button
            type="button"
            class="pill active"
            data-filter="all"
            role="tab"
            aria-selected="true"
          >
            All
          </button>
          {statuses.map((s) => (
            <button
              type="button"
              class="pill"
              data-filter={s}
              role="tab"
              aria-selected="false"
            >
              {s}
            </button>
          ))}
        </div>
      )
    }

    <div class="grid" id="work-grid">
      {
        projects.length > 0 ? (
          projects.map((project) => <ProjectCard project={project} />)
        ) : (
          <div class="no-projects">No projects found</div>
        )
      }
    </div>
    <div class="no-projects" id="work-empty" hidden>
      No projects match your search.
    </div>
  </div>
</section>

<script>
  function initWorkFilter() {
    const grid = document.getElementById('work-grid');
    const search = document.getElementById('work-search') as HTMLInputElement | null;
    const empty = document.getElementById('work-empty');
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pills .pill');
    if (!grid) return;

    let activeFilter = 'all';

    const apply = () => {
      const q = (search?.value || '').trim().toLowerCase();
      let visible = 0;
      grid.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
        const matchStatus = activeFilter === 'all' || card.dataset.status === activeFilter;
        const matchSearch = !q || (card.dataset.search || '').includes(q);
        const show = matchStatus && matchSearch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (empty) empty.hidden = visible > 0 || grid.querySelectorAll('.project-card').length === 0;
    };

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => {
          p.classList.remove('active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-selected', 'true');
        activeFilter = pill.dataset.filter || 'all';
        apply();
      });
    });

    search?.addEventListener('input', apply);
  }

  initWorkFilter();
  document.addEventListener('astro:page-load', initWorkFilter);
</script>

<style>
  .explore-section {
    padding: 56px 48px 80px;
    background-color: #ffffff;
  }

  .explore-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 20px;
  }

  .section-title {
    font-size: 28px;
    line-height: 36px;
    font-weight: 700;
    color: #1a1b1e;
    margin: 0 0 6px;
  }

  .section-description {
    font-size: 14px;
    line-height: 22px;
    color: #464646;
    margin: 0;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 280px;
    max-width: 100%;
    padding: 8px 14px;
    border: 1px solid #dee2e6;
    border-radius: 999px;
    background-color: #ffffff;
    color: #868e96;
  }

  .search-box:focus-within {
    border-color: #364fc7;
  }

  .search-box input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    font: inherit;
    font-size: 14px;
    color: #1a1b1e;
    background: transparent;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .pill {
    padding: 5px 14px;
    border: 1px solid #cefe00;
    border-radius: 999px;
    background-color: #ffffff;
    font: inherit;
    font-size: 13px;
    font-weight: 400;
    color: #364fc7;
    text-transform: capitalize;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .pill:hover {
    background-color: #f4ffcc;
  }

  .pill.active {
    background-color: #cefe00;
    color: #1a1b1e;
    font-weight: 500;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .no-projects {
    grid-column: 1 / -1;
    text-align: center;
    padding: 48px 24px;
    color: #464646;
    font-size: 16px;
  }

  @media screen and (max-width: 1280px) {
    .explore-section {
      padding: 48px 24px 64px;
    }
  }

  @media screen and (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .explore-section {
      padding: 32px 24px 48px;
    }

    .explore-header {
      flex-direction: column;
      align-items: stretch;
    }

    .search-box {
      width: 100%;
    }

    .section-title {
      font-size: 24px;
      line-height: 32px;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
