---
import '../styles/global.css';

interface Testimonial {
  originalIndex: number;
  name: string;
  role: string;
  quote: string;
  image: { src: string; width: number; height: number };
  linkedIn: string;
}

const testimonials: Testimonial[] = [
  {
    originalIndex: 1,
    name: 'Avalon Bourne',
    role: 'Founder & CEO at Sonder Youth',
    quote:
      'Nepal Climate Hub was incredibly helpful in connecting me with climate workers in Nepal. It was integral to the success of my work there. The fact that the Hub details the specific focus areas of each person and provides contact details makes it one of the best resources I have found in my international work.',
    image: {
      src: 'https://ik.imagekit.io/mbccqjudb/tr:w-500,q-75,f-auto/Testimonials/Avalon.jpeg',
      width: 500,
      height: 398,
    },
    linkedIn: 'https://au.linkedin.com/in/avalonbourne',
  },
  {
    originalIndex: 2,
    name: 'Dikshya Subedi',
    role: 'Country Lead at She Changes Climate',
    quote:
      'Nepal Climate Hub is a much-needed platform that unites grassroots activists, youth, and experts from across Nepal. Its focus on collaboration, knowledge sharing, and local climate action makes it a powerful initiative with real potential to create lasting impact. Appreciate the effort behind this initiative.',
    image: {
      src: 'https://ik.imagekit.io/mbccqjudb/tr:w-500,q-75,f-auto/Testimonials/Dikshya.jpeg',
      width: 500,
      height: 605,
    },
    linkedIn: 'https://np.linkedin.com/in/dikshya-subedi-226400170',
  },
  {
    originalIndex: 3,
    name: 'Prakriti Koirala',
    role: 'Senior Researcher at Clim Adapt',
    quote:
      "Nepal Climate Hub as a timely and truly valuable platform for Nepal’s climate community. Whether you're just starting out or have years of experience, it offers the support we need - connecting us to opportunities, people, and organizations. NCH will amplify our voices and build a more informed, collaborative climate movement.",
    image: {
      src: 'https://ik.imagekit.io/mbccqjudb/tr:w-500,q-75,f-auto/Testimonials/prakriti-koirala.jpg',
      width: 500,
      height: 500,
    },
    linkedIn: 'https://np.linkedin.com/in/prakritikoirala',
  },
];

// Loop order for the inline carousel: 2 leading clones, 3 originals, 2 trailing clones.
const slideOrder = [3, 2, 1, 2, 3, 1, 2];
const slides = slideOrder.map((index) => {
  const testimonial = testimonials.find((t) => t.originalIndex === index);
  if (!testimonial) throw new Error(`Missing testimonial ${index}`);
  return testimonial;
});

const linkedInIconPath =
  'M6 5C5.44772 5 5 5.44772 5 6V18C5 18.5523 5.44772 19 6 19H18C18.5523 19 19 18.5523 19 18V6C19 5.44772 18.5523 5 18 5H6ZM3 6C3 4.34315 4.34315 3 6 3H18C19.6569 3 21 4.34315 21 6V18C21 19.6569 19.6569 21 18 21H6C4.34315 21 3 19.6569 3 18V6ZM8 7C8.55228 7 9 7.44772 9 8V8.01C9 8.56228 8.55228 9.01 8 9.01C7.44772 9.01 7 8.56228 7 8.01V8C7 7.44772 7.44772 7 8 7ZM8 10C8.55228 10 9 10.4477 9 11V16C9 16.5523 8.55228 17 8 17C7.44772 17 7 16.5523 7 16V11C7 10.4477 7.44772 10 8 10ZM11 16C11 16.5523 11.4477 17 12 17C12.5523 17 13 16.5523 13 16V13C13 12.7348 13.1054 12.4804 13.2929 12.2929C13.4804 12.1054 13.7348 12 14 12C14.2652 12 14.5196 12.1054 14.7071 12.2929C14.8946 12.4804 15 12.7348 15 13V16C15 16.5523 15.4477 17 16 17C16.5523 17 17 16.5523 17 16V13C17 12.2043 16.6839 11.4413 16.1213 10.8787C15.5587 10.3161 14.7957 10 14 10C13.5483 10 13.1071 10.1019 12.7071 10.2929C12.5261 10.1119 12.2761 10 12 10C11.4477 10 11 10.4477 11 11V16Z';
---

<div class="section-container">
  <h2 class="section-heading">Impact Stories</h2>
  <div class="container">
    <div class="slideshow-container">
      <div class="slides-wrapper">
        {
          slides.map((t) => (
            <div class="mySlides" data-original-index={t.originalIndex}>
              <div class="image-wrapper">
                <img
                  src={t.image.src}
                  alt={t.name}
                  width={t.image.width}
                  height={t.image.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="card-content">
                <p class="testimonial">{t.quote}</p>
                <div class="details">
                  <h3 class="name">{t.name}</h3>
                  <p class="profession">{t.role}</p>
                  <div class="logo">
                    <a
                      href={t.linkedIn}
                      class="social-link"
                      aria-label={`${t.name} on LinkedIn`}
                      target="_blank"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                      >
                        <path
                          fill-rule="evenodd"
                          clip-rule="evenodd"
                          d={linkedInIconPath}
                          fill="#212529"
                        />
                        <path
                          fill-rule="evenodd"
                          clip-rule="evenodd"
                          d={linkedInIconPath}
                          fill="black"
                          fill-opacity="0.2"
                        />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <br />

  <div style="text-align: center" class="controls">
    <a class="prev" data-slide-step="-1">&#10094;</a>
    <a class="next" data-slide-step="1">&#10095;</a>
    <span class="dot" data-slide-to="1"></span>
    <span class="dot" data-slide-to="2"></span>
    <span class="dot" data-slide-to="3"></span>
  </div>
</div>

<script>
  const NUM_SLIDES = 3;
  const AUTO_SLIDE_MS = 4000;
  const TRANSITION = "transform 0.5s ease-in-out";
  let teardown: (() => void) | undefined;

  function initTestimonials() {
    const slidesWrapper = document.querySelector<HTMLElement>(".slides-wrapper");
    const container = document.querySelector<HTMLElement>(".slideshow-container");
    const root = container?.closest<HTMLElement>(".section-container") ?? container;
    const dots = document.querySelectorAll<HTMLElement>(".dot");
    const allSlides = document.querySelectorAll<HTMLElement>(".mySlides");
    if (!slidesWrapper || !container || !root || allSlides.length === 0 || dots.length === 0) return;

    let current = 1;
    let displayed = 2;
    let timer: number | undefined;

    const slideWidth = () => {
      const style = getComputedStyle(slidesWrapper);
      const gap = Number.parseInt(style.columnGap || style.gap || "0", 10);
      return allSlides[0].offsetWidth + gap;
    };
    const place = () => {
      slidesWrapper.style.transform = `translateX(-${displayed * slideWidth()}px)`;
    };
    const jump = () => {
      slidesWrapper.style.transition = "none";
      displayed = current + 1;
      place();
      void slidesWrapper.offsetWidth;
      slidesWrapper.style.transition = TRANSITION;
    };
    const updateDots = () => {
      dots.forEach((dot, i) => dot.classList.toggle("active", i === current - 1));
    };
    const step = (n: number) => {
      current += n;
      displayed += n;
      place();
      updateDots();
    };
    const goTo = (n: number) => {
      current = n;
      displayed = n + 1;
      place();
      updateDots();
    };
    const start = () => {
      stop();
      timer = window.setInterval(() => step(1), AUTO_SLIDE_MS);
    };
    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const onTransitionEnd = () => {
      if (current > NUM_SLIDES) current = 1;
      else if (current < 1) current = NUM_SLIDES;
      else return;
      jump();
      updateDots();
    };
    const onClick = (event: Event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>("[data-slide-step], [data-slide-to]");
      if (!target) return;
      if (target.dataset.slideStep) step(Number(target.dataset.slideStep));
      else goTo(Number(target.dataset.slideTo));
    };

    jump();
    updateDots();
    start();
    slidesWrapper.addEventListener("transitionend", onTransitionEnd);
    root.addEventListener("click", onClick);
    container.addEventListener("mouseenter", stop);
    container.addEventListener("mouseleave", start);
    window.addEventListener("resize", jump);

    teardown = () => {
      stop();
      slidesWrapper.removeEventListener("transitionend", onTransitionEnd);
      root.removeEventListener("click", onClick);
      container.removeEventListener("mouseenter", stop);
      container.removeEventListener("mouseleave", start);
      window.removeEventListener("resize", jump);
    };
  }

  document.addEventListener("astro:page-load", initTestimonials);
  document.addEventListener("astro:before-swap", () => {
    teardown?.();
    teardown = undefined;
  });
</script>

<style>
  .section-container {
    margin: 53px auto;
    position: relative;
  }

  .section-container .section-heading {
    font-size: 24px;
    font-weight: 700;
    line-height: 32px;
    margin-bottom: 24px;
  }

  /* .container {
    border: 2px solid red;
  } */

  /* Slideshow container */
  .slideshow-container {
    max-width: 1280px;
    position: relative;
    margin: auto;
    overflow: hidden;
  }

  /* Wrapper for all slides */
  .slides-wrapper {
    display: flex;
    gap: 48px;
    transition: transform 0.5s ease-in-out;
  }

  .mySlides {
    width: 637px;
    height: 334px;
    flex-shrink: 0;
    position: relative;

    display: flex;
    gap: 24px;
  }

  .image-wrapper {
    width: 248px;
    height: 286px;
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .mySlides img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: none;
  }

  .card-content {
    flex: 1;
    font-family: "Roboto", sans-serif;
  }

  .testimonial {
    line-height: 25px;
    margin-bottom: 32px;
    color: #333;
  }

  .name {
    font-size: 18px;
    font-weight: 600;
    color: #000;
  }

  .profession {
    font-size: 14px;
    margin-bottom: 14px;
    color: #666;
  }

  .prev,
  .next {
    cursor: pointer;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: auto;
    padding: 4px 8px;
    font-weight: bold;
    font-size: 16px;
    transition: 0.6s ease;
    border-radius: 4px;
    z-index: 12123;
  }

  .prev {
    left: 0;
  }

  .next {
    right: 0;
    border-color: blue;
  }

  .prev:hover,
  .next:hover {
    background-color: rgba(0, 0, 0, 0.089);
  }

  .controls {
    position: relative;
    width: 160px;
    margin: 0 auto;
  }

  .dot {
    cursor: pointer;
    height: 12px;
    width: 12px;
    margin: 0 2px;
    background-color: #bbb;
    border-radius: 50%;
    display: inline-block;
    transition: background-color 0.6s ease;
  }

  .active,
  .dot:hover {
    background-color: #717171;
  }

  @media screen and (max-width: 768px) {
    .section-container {
      margin: 24px 32px 64px;
    }

    .slides-wrapper {
      gap: 0px;
    }

    .mySlides {
      width: 100%;
      height: auto;
      flex-direction: column;
    }

    .image-wrapper {
      width: 100%;
      height: 240px;
    }

    .mySlides img {
      object-position: top;
    }
  }
</style>
