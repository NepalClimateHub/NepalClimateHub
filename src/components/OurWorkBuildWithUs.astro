---
import {
  RiFileTextLine,
  RiHandHeartLine,
  RiHeartLine,
  RiTeamLine,
} from 'react-icons/ri';

const ways = [
  { Icon: RiTeamLine, title: 'Volunteer', desc: 'Be part of climate action.' },
  { Icon: RiHandHeartLine, title: 'Partner', desc: 'Build stronger networks.' },
  {
    Icon: RiHeartLine,
    title: 'Sponsor',
    desc: 'Support our programs and operations.',
  },
  {
    Icon: RiFileTextLine,
    title: 'Contribute resources',
    desc: 'Share tools, knowledge, or opportunities.',
  },
];
---

<section class="build-with-us-section">
  <div class="section-container inner">
    <h2 class="section-heading">Build with us</h2>
    <p class="section-intro">
      Nepal Climate Hub is powered by youth, volunteers, mentors, and partners
      and we're always <strong>open to collaboration</strong>. Ways you can
      support us are as follows:
    </p>

    <div class="grid">
      {
        ways.map(({ Icon, title, desc }) => (
          <div class="card">
            <div class="icon-circle">
              <Icon aria-hidden="true" size={14} />
            </div>
            <h3 class="card-title">{title}</h3>
            <p class="card-description">{desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .build-with-us-section {
    background-color: #cefe00;
    padding: 0 48px;
  }

  .inner {
    position: relative;
    padding: 56px 0 48px;
  }

  .section-heading {
    position: absolute;
    top: -16px;
    left: 0;
    margin: 0;
    padding: 2px 14px;
    font-size: 28px;
    font-weight: 700;
    color: #ffffff;
    background-color: #1a1b1e;
    transform: rotate(-3deg);
    max-width: fit-content;
  }

  .section-intro {
    font-size: 16px;
    line-height: 26px;
    color: #1a1b1e;
    margin: 0 0 24px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 16px;
    background-color: #f8f9fa;
    border-radius: 4px;
  }

  .icon-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #1a1b1e;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .icon-circle :global(svg) {
    color: #ffffff;
  }

  .card-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    color: #1a1b1e;
    margin: 0 0 4px;
  }

  .card-description {
    font-size: 14px;
    line-height: 1.4;
    color: #1a1b1e;
    margin: 0;
  }

  @media screen and (max-width: 1280px) {
    .build-with-us-section {
      padding: 0 24px;
    }
  }

  @media screen and (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .inner {
      padding: 48px 0 32px;
    }

    .section-heading {
      font-size: 24px;
    }

    .section-intro {
      font-size: 14px;
      line-height: 22px;
      margin-bottom: 20px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
