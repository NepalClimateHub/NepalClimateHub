---
import NewsFilter from '../components/NewsFilter';
import type { NewsFilterState } from '../utils/newsFilters';
import type { SortData } from '../utils/sortNewsArray';

interface Props {
  news: SortData[];
  currentPage: number;
  pageSize: number;
  totalNews: number;
  totalPages: number;
  activeFilters: NewsFilterState;
}

const { news, currentPage, pageSize, totalNews, totalPages, activeFilters } =
  Astro.props;
---

<div class="section-container">
  <NewsFilter
    client:load
    news={news}
    currentPage={currentPage}
    pageSize={pageSize}
    totalNews={totalNews}
    totalPages={totalPages}
    activeFilters={activeFilters}
  />
</div>
<style>
  .section-container {
    margin: 24px auto 83px;
    position: relative;
  }

  /* media queries for mobile */

  @media screen and (max-width: 768px) {
    .section-container {
      margin: 24px 32px 64px;
    }

    .news-container {
      flex-direction: column;
      gap: 24px;
    }

    .news-card {
      width: 100%;
      box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);

    }
  }
</style>
