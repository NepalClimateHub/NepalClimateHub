---
import { API_BASE_URL } from 'astro:env/client';

interface Props {
  formBtnVariant?: 'footer' | 'primary';
}

const { formBtnVariant = 'footer' } = Astro.props;
const inputId = `userEmail-${crypto.randomUUID().slice(0, 8)}`;
---


<p>Subscribe to future news and updates.</p>

<div class="emailWrapper">
    <form class="form" method="post" data-email-form data-api-url={API_BASE_URL}>
        <label for={inputId} class="visually-hidden">Email address</label>
        <input
        id={inputId}
        type="email"
        placeholder="Email"
        name="email"
        autocomplete="email"
        required
        />
        <button class={formBtnVariant}>Submit</button>
    </form>
    <p class="emailMessage" role="status" aria-live="polite"></p>
</div>

<script>
  const initializeEmailSubscriptionForms = () => {
    document.querySelectorAll<HTMLFormElement>("form[data-email-form]").forEach((form) => {
      if (form.dataset.emailFormInitialized === "true") return;

      form.dataset.emailFormInitialized = "true";
  const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
  const emailMessage = form.parentElement?.querySelector<HTMLElement>(".emailMessage");

  // Get API URL from data attribute (set server-side)
  const API_BASE_URL = form.getAttribute("data-api-url");

  if (emailInput && emailMessage) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      
      // Reset previous state
      emailMessage.textContent = "";
      
      const email = emailInput.value.trim();
      
      if (!API_BASE_URL) {
        emailMessage.textContent = "Unable to subscribe. Please try again later.";
        emailMessage.style.display = "block";
        emailMessage.style.color = "#ef4444";
        return;
      }
      
      try {
        const response = await fetch(
          `${API_BASE_URL}/api/v1/email-subscription/subscribe`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ email }),
          }
        );

        if (response.ok) {
        emailInput.value = "";
        emailMessage.textContent = "";
        emailMessage.textContent = "Thank you for staying connected!";
        emailMessage.style.display = "block";
        emailMessage.style.color = "#cefe00";
        } else {
          throw new Error(`HTTP ${response.status}`);
        }
      } catch {
        emailMessage.textContent = "Unable to subscribe. Please try again later.";
        emailMessage.style.display = "block";
        emailMessage.style.color = "#ef4444";
      }
    });
  }
    });
  };

  initializeEmailSubscriptionForms();
  document.addEventListener("astro:page-load", initializeEmailSubscriptionForms);
</script>

<style>
p {
    color: #ffffff;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
}

.emailWrapper {
  position: relative;
  /* height: 70px; */
  margin-top: 20px;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.emailMessage {
  display: block;
  /* position: absolute;
  bottom: -8px;
  left: 0; */
  font-style: italic;
  margin-top: 8px;
}

.form {
  display: flex;
  gap: 8px;
  align-items: center;
}

 .form input {
    flex: 1;
    border-radius: 16px;
    font-size: 14px;
    padding: 8px 16px;
    outline: 2px solid #fff;
    border: none;
    box-sizing: border-box;
    min-width: 100px;
    max-width: 500px;
  }

  .form input:active,
  .form input:focus {
    outline: 2px solid #cefe00;
  }

.form button {
  padding: 8px 22px;
  cursor: pointer;
  font-weight: 500;
  border-radius: 24px;
  transition: all 0.2s ease;
  border: none;
  width: fit-content
}

/* Footer variant (default) */
.form button.footer {
  color: white;
  background-color: transparent;
  border: 1px solid white;
}

.form button.footer:hover {
  background-color: #cefe00;
  border-color: #cefe00;
  color: #25262b;
}

/* Primary variant */
.form button.primary {
  background-color: #cefe00;
  border-color: #cefe00;
  color: #25262b;
}

.form button.primary:hover {
  background-color: #b8e600;
  border-color: #b8e600;
  color: #25262b;
}

@media screen and (max-width: 348px) {
    .emailWrapper {
      height: 100px;
    }
  }

@media screen and (max-width: 500px) {
  .form {
    flex-direction: column;
    align-items: stretch;
  }
}
</style>
