---
import { type Vacancy, fetchVacancies } from '../api/vacancies.api';
import { VolunteerOpenRoles } from './VolunteerOpenRoles';

let initialVacancies: Vacancy[] = [];
try {
  const res = await fetchVacancies();
  initialVacancies = res?.data || [];
} catch (error) {
  console.error('Error pre-fetching vacancies during SSR:', error);
}
---

<div class="open-roles-container">
  <div class="open-roles-section">
    <h2 class="sub-heading">Open roles</h2>
    <p class="roles-intro">
      We are looking for purpose-driven individuals for the following roles.
    </p>

    <VolunteerOpenRoles client:visible initialVacancies={initialVacancies} />
  </div>
</div>

<style is:global>
  .open-roles-container {
    max-width: 1280px;
    margin: 0 auto 120px;
    box-sizing: border-box;
  }

  .open-roles-section {
    margin-top: 0;
  }

  .sub-heading {
    font-size: clamp(22px, 2.5vw, 28px);
    line-height: 1.25;
    font-weight: 700;
    margin: 0 0 12px;
    color: #1a1b1e;
  }

  .roles-intro {
    max-width: none;
    font-size: 17px;
    line-height: 1.55;
    margin: 0 0 32px;
    color: #4b5563;
    text-wrap: pretty;
  }

  .roles-loading,
  .roles-error {
    padding: 32px;
    text-align: center;
    color: #6b7280;
    font-size: 15px;
  }

  .no-roles-card {
    background: #f8f9fa;
    border: 1px dashed #ced4da;
    border-radius: 16px;
    padding: 32px;
    text-align: center;
  }

  .no-roles-text {
    font-size: 15px;
    color: #495057;
    margin: 0;
  }

  .no-roles-text a {
    color: #364fc7;
    font-weight: 600;
  }

  .roles-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 0;
  }

  .role-card {
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
    background: #ffffff;
    border: 1px solid #e8eaed;
    border-radius: 20px;
    padding: clamp(20px, 3vw, 28px) clamp(20px, 3vw, 32px);
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 4px 16px rgba(15, 23, 42, 0.05);
    display: flex;
    flex-direction: column;
    gap: 0;
    transition:
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .role-card:hover {
    border-color: #d4e85a;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.06),
      0 8px 24px rgba(15, 23, 42, 0.08);
  }

  .role-card__head {
    padding-bottom: 16px;
    border-bottom: 1px solid #f1f3f5;
    margin-bottom: 16px;
  }

  .role-card__title-block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .role-title {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    color: #1a1b1e;
    margin: 0;
    line-height: 1.2;
  }

  .role-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .role-badge {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    padding: 5px 12px;
    border-radius: 999px;
    background: #cefe00;
    color: #1a1b1e;
  }

  .role-badge--muted {
    background: #f1f3f5;
    color: #495057;
    font-weight: 500;
  }

  .role-lead {
    font-size: 15px;
    line-height: 1.6;
    color: #495057;
    margin: 0 0 20px;
  }

  .role-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(12px, 2vw, 20px);
    margin-bottom: 20px;
  }

  .role-card__foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid #f1f3f5;
  }

  .role-panel {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 16px;
    border: 1px solid #eef0f2;
  }

  .role-panel__title {
    font-size: 14px;
    font-weight: 700;
    color: #1a1b1e;
    margin: 0 0 12px;
    letter-spacing: 0.01em;
  }

  .role-list {
    margin: 0;
    padding-left: 1.1rem;
  }

  .role-list li {
    overflow-wrap: anywhere;
    margin-bottom: 8px;
    line-height: 1.5;
    color: #374151;
    font-size: 14px;
  }

  .role-list li:last-child {
    margin-bottom: 0;
  }

  .apply-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    background: #cefe00;
    color: #1a1b1e;
    text-decoration: none;
    transition:
      background 0.2s ease,
      transform 0.15s ease;
  }

  .apply-button:hover {
    background: #b8e600;
  }

  .apply-button--wide {
    width: fit-content;
    padding: 12px 24px;
  }

  .role-footnote {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: #6b7280;
    text-align: center;
  }

  .role-footnote a {
    color: #364fc7;
    font-weight: 500;
    text-decoration: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 1280px) {
    .open-roles-container {
      padding: 0 48px;
      margin-bottom: 50px;
    }
  }

  @media screen and (max-width: 1024px) {
    .role-card__title-block {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .role-content {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 768px) {
    .open-roles-container {
      padding: 20px 24px;
      margin-bottom: 32px;
    }

    .apply-button--wide {
      width: 100%;
    }
  }
</style>
