---
import { VolunteerOpenRoles } from './VolunteerOpenRoles';
---

<div class="section-container">
  <div class="open-roles-section">
    <h2 class="sub-heading">Open roles</h2>
    <p class="roles-intro">
      We are looking for purpose-driven individuals for the following roles.
    </p>

    <VolunteerOpenRoles client:load />
  </div>
</div>

<style is:global>
  .section-container {
    max-width: 1280px;
    margin: 0 auto;
    margin-bottom: 120px;
  }

  .open-roles-section {
    margin-top: 0;
  }

  .sub-heading {
    font-size: clamp(22px, 2.5vw, 28px);
    line-height: 1.25;
    font-weight: 700;
    margin: 0 0 12px;
    color: #1a1b1e;
  }

  .roles-intro {
    max-width: none;
    font-size: 17px;
    line-height: 1.55;
    margin: 0 0 32px;
    color: #4b5563;
    text-wrap: pretty;
  }

  .roles-loading, .roles-error {
    padding: 32px;
    text-align: center;
    color: #6b7280;
    font-size: 15px;
  }

  .no-roles-card {
    background: #f8f9fa;
    border: 1px dashed #ced4da;
    border-radius: 16px;
    padding: 32px;
    text-align: center;
  }

  .no-roles-text {
    font-size: 15px;
    color: #495057;
    margin: 0;
  }

  .no-roles-text a {
    color: #364fc7;
    font-weight: 600;
  }

  .roles-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 0;
  }

  .role-card {
    width: 100%;
    background: #ffffff;
    border: 1px solid #e8eaed;
    border-radius: 20px;
    padding: clamp(20px, 3vw, 28px) clamp(20px, 3vw, 32px);
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 4px 16px rgba(15, 23, 42, 0.05);
    display: flex;
    flex-direction: column;
    gap: 0;
    transition:
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .role-card:hover {
    border-color: #d4e85a;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.06),
      0 8px 24px rgba(15, 23, 42, 0.08);
  }

  .role-card__head {
    padding-bottom: 16px;
    border-bottom: 1px solid #f1f3f5;
    margin-bottom: 16px;
  }

  .role-card__title-block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .role-title {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    color: #1a1b1e;
    margin: 0;
    line-height: 1.2;
  }

  .role-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .role-badge {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    padding: 5px 12px;
    border-radius: 999px;
    background: #cefe00;
    color: #1a1b1e;
  }

  .role-badge--muted {
    background: #f1f3f5;
    color: #495057;
    font-weight: 500;
  }

  .role-lead {
    font-size: 15px;
    line-height: 1.6;
    color: #495057;
    margin: 0 0 20px;
  }

  .role-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(12px, 2vw, 20px);
    margin-bottom: 20px;
  }

  .role-card__foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid #f1f3f5;
  }

  .role-panel {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 16px;
    border: 1px solid #eef0f2;
  }

  .role-panel__title {
    font-size: 14px;
    font-weight: 700;
    color: #1a1b1e;
    margin: 0 0 12px;
    letter-spacing: 0.01em;
  }

  .role-list {
    margin: 0;
    padding-left: 1.1rem;
  }

  .role-list li {
    margin-bottom: 8px;
    line-height: 1.5;
    color: #374151;
    font-size: 14px;
  }

  .role-list li:last-child {
    margin-bottom: 0;
  }

  .apply-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    background: #cefe00;
    color: #1a1b1e;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .apply-button:hover {
    background: #b8e600;
  }

  .apply-button--wide {
    width: fit-content;
    padding: 12px 24px;
  }

  .role-footnote {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: #6b7280;
    text-align: center;
  }

  .role-footnote a {
    color: #364fc7;
    font-weight: 500;
    text-decoration: none;
  }

  /* Modal Styling */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-content {
    background: #ffffff;
    border-radius: 20px;
    max-width: 650px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 32px;
    position: relative;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .modal-close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: transparent;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: #64748b;
  }

  .modal-close:hover {
    color: #0f172a;
  }

  .modal-header {
    margin-bottom: 24px;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 16px;
  }

  .modal-title {
    font-size: 22px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 4px;
  }

  .modal-subtitle {
    font-size: 14px;
    color: #64748b;
    margin: 0;
  }

  .modal-error-alert {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
    margin-bottom: 16px;
  }

  .vacancy-apply-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-group label {
    font-size: 14px;
    font-weight: 600;
    color: #334155;
  }

  .form-group label .req {
    color: #ef4444;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 10px 14px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: #364fc7;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 12px;
    padding-top: 16px;
    border-top: 1px solid #f1f5f9;
  }

  .cancel-button {
    background: #f1f5f9;
    color: #334155;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }

  .cancel-button:hover {
    background: #e2e8f0;
  }

  .modal-success-state {
    text-align: center;
    padding: 24px 12px;
  }

  .success-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #dcfce7;
    color: #166534;
    font-size: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }

  .success-title {
    font-size: 22px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 8px;
  }

  .success-text {
    font-size: 15px;
    color: #475569;
    margin: 0 0 24px;
    line-height: 1.6;
  }

  @media screen and (max-width: 768px) {
    .section-container {
      padding: 20px 24px;
      margin-bottom: 32px;
    }

    .role-content {
      grid-template-columns: 1fr;
    }

    .form-group-row {
      grid-template-columns: 1fr;
    }

    .modal-content {
      padding: 20px;
    }
  }
</style>
