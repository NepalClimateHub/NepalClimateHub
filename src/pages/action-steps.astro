---
export const prerender = true;

import '../styles/global.css';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import PersonalCommitment from '@components/PersonalCommitment.astro';
import BaseLayout from '../layouts/Layout.astro';
---

<BaseLayout title="Action Steps | Nepal Climate Hub"
  description="Practical steps young people in Nepal can take today to cut emissions, adapt to climate change and support climate action in their communities.">
	<main class="main-container">

  <!-- header section  -->
  
  <section class="header-section">
    <Header logoColor="#1A1B1E" />

    <!-- a mini navbar -->
    <div class="mini-nav">
      <a href="/">Home</a>
    </div>
  </section>

    <section class="commitment-cards-section">
      <PersonalCommitment />
    </section>


    <section class="footer-section">
      <Footer />
    </section>
	</main>
</BaseLayout>


<style>
   section {
    padding: 0px 48px;
  }

  .footer-section {
    background-color: #1A1B1E;
    color: white;
  }

  @media  screen and (max-width: 768px) {
  section {
    padding: 0px;
  }
}
</style>
