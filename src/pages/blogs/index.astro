---
// Mark this page as dynamic (not pre-rendered)
export const prerender = false;

import '../../styles/global.css';
import BlogHighlights from '@components/BlogHighlights.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { fetchAllBlogs, getFeaturedPost } from '../../api';
import BlogCard from '../../components/BlogCard';
import BlogCategoryFilter from '../../components/BlogCategoryFilter.tsx';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import BaseLayout from '../../layouts/Layout.astro';
import type { Blog } from '../../types/blog';

const PAGE_SIZE = 12;
const categories = new Set([
  'Voices & Stories',
  'Community',
  'Education',
  'Environment',
  'Climate Technology',
  'Climate Policy',
  'Sustainability',
  'Climate Justice',
  'Climate Science',
]);
const requestedCategory = Astro.url.searchParams.get('category') || 'All';
const activeCategory = categories.has(requestedCategory)
  ? requestedCategory
  : 'All';
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = Number.isFinite(requestedPage) && requestedPage > 0
  ? requestedPage
  : 1;
const offset = (currentPage - 1) * PAGE_SIZE;

let pageBlogs: Blog[] = [];
let totalBlogs = 0;
let featuredBlog: Blog | null = null;

try {
  const pageRequest = fetchAllBlogs({
    category: activeCategory === 'All' ? undefined : activeCategory,
    limit: PAGE_SIZE,
    offset,
  });
  const featuredRequest =
    activeCategory === 'All' && currentPage === 1
      ? pageRequest
      : fetchAllBlogs({ limit: PAGE_SIZE, offset: 0 });
  const [pageResponse, featuredResponse] = await Promise.all([
    pageRequest,
    featuredRequest,
  ]);

  pageBlogs = pageResponse.data || [];
  totalBlogs = pageResponse.meta?.count || 0;
  featuredBlog = getFeaturedPost(featuredResponse.data || []);
} catch (error) {
  console.error('Error fetching blogs:', error);
  pageBlogs = [];
  totalBlogs = 0;
  featuredBlog = null;
}
const latestBlogs: Blog[] = pageBlogs.slice(0, 3);
const categoryBlogs = pageBlogs.map(
  ({
    id,
    title,
    excerpt,
    author,
    authorUser,
    readingTime,
    category,
    publishedDate,
    bannerImageUrl,
  }) => ({
    id,
    title,
    excerpt,
    author,
    authorUser: authorUser
      ? { profilePhotoUrl: authorUser.profilePhotoUrl }
      : undefined,
    readingTime,
    category,
    publishedDate,
    bannerImageUrl,
  })
);
const totalPages = Math.max(1, Math.ceil(totalBlogs / PAGE_SIZE));
---

<BaseLayout title="Blogs | Nepal Climate Hub">
  <main class="main-container">
    <section class="header-section">
      <Header logoColor="#1A1B1E" />
   <Breadcrumbs
        data={[
          { label: "Blogs", href: "/blogs" },

        ]}
      />
    </section>

    <section class="blogs-section">
      <div class="blogs-container">
        <!-- Featured Post -->
        <div class="featured-post">
          <h2 class="section-title">Featured Post</h2>
          {featuredBlog ? (
            <div class="featured-card-wrapper">
              <BlogCard
                blog={featuredBlog}
                cardType='featured'
              />
            </div>
          ) : (
            <p class="no-blogs">No featured blog available.</p>
          )}
        </div>

        <!-- Latest Posts -->
        <BlogHighlights title="Latest Posts" blogs={latestBlogs} />
      </div>
    </section>

    <section class="category-section">
      <BlogCategoryFilter
        blogs={categoryBlogs}
        activeCategory={activeCategory}
        currentPage={currentPage}
        totalPages={totalPages}
      />
    </section>

    <section class="footer-section">
      <Footer />
    </section>
  </main>
</BaseLayout>

<style>
  section {
    padding: 0px 48px;
  }

  .blogs-section {
    padding-top: 24px;
    margin-bottom: 80px;
  }

  .blogs-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 24px;
    font-weight: 600;
    color: #1a1b1e;
    margin: 0 0 16px 0;
  }

  .featured-post {
    display: flex;
    flex-direction: column;
  }

  .featured-card-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 300px;
  }

  .latest-posts {
    display: flex;
    flex-direction: column;
  }

  .latest-cards-wrapper {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
    border-radius: 16px;
    overflow: hidden;
    background-color: #F8F9FA;
  }

  .category-section {
    margin-bottom: 32px;
  }

  .no-blogs {
    font-size: 16px;
    color: rgba(26, 27, 30, 0.6);
    text-align: center;
    padding: 48px 24px;
    background-color: #F8F9FA;
    border-radius: 16px;
  }

  .footer-section {
    background-color: #1a1b1e;
    color: white;
    margin-top: 80px;
  }

  /* Responsive styles */
  @media screen and (max-width: 1024px) {
    .blogs-section {
      margin-bottom: 0;
    }
  
    .blogs-container {
      grid-template-columns: 1fr;
      gap: 48px;
      margin: 24px auto 0 auto;
    }

    .featured-card-wrapper {
      min-height: 250px;
    }

    .footer-section {
      margin-top: 32px;
    }
  }

  @media screen and (max-width: 768px) {
    section {
      padding: 0px;
    }

    .blogs-section {
      padding: 16px 24px 16px 24px;
    }

    .blogs-container {
      gap: 32px;
    }

    .section-title {
      font-size: 20px;
    }

    .latest-cards-wrapper {
      flex-direction: column;
      width: 100%;
    }

    .latest-posts {
      display: none;
    }
  }
</style>
