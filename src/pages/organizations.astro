---
export const prerender = true;

import '../styles/global.css';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import CardFilterSection from '@layouts/CardFilterSection.astro';
import BaseLayout from '../layouts/Layout.astro';

import Breadcrumbs from '@components/Breadcrumbs.astro';
import OrganizationsJSON from '../data/organizations.json';
import { OrganizationSection } from './sections/OrganizationSection';

const organizationFontStylesheet =
  'https://fonts.googleapis.com/css2?family=Roboto:wght@400..700&display=swap';

const organizationListing = OrganizationsJSON.map(
  ({ id, name, description, address, tags, logoUrl, slug }) => ({
    id,
    name,
    description:
      description.length > 110
        ? `${description.substring(0, 110)}...`
        : description,
    address,
    tags,
    logoUrl,
    slug,
  })
);
---

<BaseLayout
  title="Organizations | Nepal Climate Hub"
  description="Discover climate-focused organizations working across Nepal, their work and themes, and find ways to collaborate."
  fontStylesheetHref={organizationFontStylesheet}
>
  <main class="main-container">
    <!-- header section  -->

    <section class="header-section">
      <Header logoColor="#1A1B1E" />

      <!-- a mini navbar -->
      <Breadcrumbs
        data={[
          { label: "Organizations", href: "/organizations" },
        ]}
      />
    </section>

    <div class="organization-wrapper">
      <section class="filter-section">
        <CardFilterSection
          heading="Organizations"
          type="organization"
          filter="false"
        />
      </section>
      <section>
        <OrganizationSection
          client:load
          cardsArray={organizationListing}
        />
      </section>
    </div>

    <section class="footer-section">
      <Footer />
    </section>
  </main>
</BaseLayout>

<style>
  section {
    padding: 0px 48px;
  }

  .organization-wrapper {
    background-color: #ebf1f7;
  }

  .footer-section {
    background-color: #1a1b1e;
    color: white;
  }

  @media screen and (max-width: 768px) {
    section {
      padding: 0px;
    }
  }
</style>
