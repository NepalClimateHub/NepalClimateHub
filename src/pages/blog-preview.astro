---
export const prerender = false;
import '../styles/global.css';
import { CMS_API_BASE_URL } from 'astro:env/server';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { fetchAllBlogs } from '../api';
import BlogArticle from '../components/BlogArticle.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BaseLayout from '../layouts/Layout.astro';
import { parseBlogPreview } from '../utils/blogPreview';

const PREVIEW_ROLES = new Set(['SUPER_ADMIN', 'ADMIN', 'CONTENT_ADMIN']);

const previewAccessToken = (value: FormDataEntryValue | null): string | null =>
  typeof value === 'string' && value.length > 0 && value.length <= 8192
    ? value
    : null;

const previewAuthorizationError = async (
  accessToken: string | null
): Promise<Response | null> => {
  if (!accessToken) {
    return new Response('Preview authentication is required', {
      status: 401,
      headers: { 'Cache-Control': 'no-store' },
    });
  }

  let response: Response;
  try {
    response = await fetch(`${CMS_API_BASE_URL}/api/v1/users/me`, {
      headers: {
        Authorization: `Bearer ${accessToken}`,
        Accept: 'application/json',
      },
    });
  } catch {
    return new Response('Preview authentication is temporarily unavailable', {
      status: 503,
      headers: { 'Cache-Control': 'no-store' },
    });
  }

  if (!response.ok) {
    return new Response('Preview authentication failed', {
      status: 401,
      headers: { 'Cache-Control': 'no-store' },
    });
  }

  const body = (await response.json().catch(() => null)) as {
    data?: { role?: unknown };
  } | null;
  if (!PREVIEW_ROLES.has(String(body?.data?.role))) {
    return new Response('Preview access is forbidden', {
      status: 403,
      headers: { 'Cache-Control': 'no-store' },
    });
  }

  return null;
};

const headers = Astro.response.headers;
headers.set('Cache-Control', 'no-store');
headers.set('X-Robots-Tag', 'noindex, nofollow');
headers.set(
  'Content-Security-Policy',
  "script-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
);

if (Astro.request.method !== 'POST') {
  return new Response('Method Not Allowed', {
    status: 405,
    headers: { Allow: 'POST', 'Cache-Control': 'no-store' },
  });
}

const form = await Astro.request.formData().catch(() => null);
const authorizationError = await previewAuthorizationError(
  previewAccessToken(form?.get('accessToken') ?? null)
);
if (authorizationError) return authorizationError;

const blog = parseBlogPreview(form?.get('payload'));

if (!blog) {
  return new Response('Invalid preview payload', {
    status: 400,
    headers: { 'Cache-Control': 'no-store' },
  });
}

const topReads = await fetchAllBlogs({ limit: 100 })
  .then((recent) => recent.data.filter((post) => post.isTopRead).slice(0, 3))
  .catch(() => []);

const authorImagePlaceholder = `https://ui-avatars.com/api/?name=${encodeURIComponent(
  blog.author
)}&background=1a1b1e&color=cefe00&size=72`;
---

<BaseLayout title={`${blog.title} | Nepal Climate Hub`}>
  <main class="main-container">
    <section class="header-section">
      <Header logoColor="#1A1B1E" />
      <Breadcrumbs data={[{ label: "Blogs", href: "/blogs" }]} />
    </section>

    <BlogArticle
      blog={blog}
      topReads={topReads}
      showBottomAuthor
      authorImagePlaceholder={authorImagePlaceholder}
    />

    <section class="footer-section">
      <Footer />
    </section>
  </main>
</BaseLayout>

<style>
  section {
    padding: 0 48px;
  }

  .footer-section {
    background-color: #1a1b1e;
    color: white;
  }

  .header-section {
    width: 100%;
  }

  @media (max-width: 768px) {
    section {
      padding: 0;
    }
  }
</style>
