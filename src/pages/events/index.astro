---
// Mark this page as dynamic (not pre-rendered)
export const prerender = false;

import '../../styles/global.css';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { fetchAllEventSummaries, fetchEventSummaries } from '../../api';
import EventFilter from '../../components/EventFilter';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import CardFilterSection from '../../layouts/CardFilterSection.astro';
// import eventsTemp from '../data/eventsTemp.json';
import BaseLayout from '../../layouts/Layout.astro';
import { getEventStatus } from '../../utils/listingStatus';
import {
  filterEvents,
  hasActiveEventFilters,
  parseEventFilters,
  serializeEventFilters,
} from '../../utils/eventFilters';

const PAGE_SIZE = 12;
const requestedPage = Number.parseInt(
  Astro.url.searchParams.get('page') || '1',
  10
);
const currentPage =
  Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

const activeFilters = parseEventFilters(Astro.url.searchParams);
const filtersActive = hasActiveEventFilters(activeFilters);

function stripHtml(html: string) {
  return html.replace(/<[^>]*>/g, '');
}

function mapEventSummary(event: any) {
  const formatMap: Record<string, string> = {
    IN_PERSON: 'In-person',
    VIRTUAL: 'Virtual',
    HYBRID: 'Hybrid',
    'In-person': 'In-person',
    Virtual: 'Virtual',
    Hybrid: 'Hybrid',
  };

  const costMap: Record<string, string> = {
    FREE: 'Free',
    PAID: 'Paid',
    PARTIALLY_FUNDED: 'Partially Funded',
    FULLY_FUNDED: 'Fully Funded',
    Free: 'Free',
    Paid: 'Paid',
    'Partially Funded': 'Partially Funded',
    'Fully Funded': 'Fully Funded',
  };

  return {
    id: event.id,
    title: event.title,
    type:
      event.type.charAt(0).toUpperCase() + event.type.slice(1).toLowerCase(),
    locationType:
      event.locationType.charAt(0).toUpperCase() +
      event.locationType.slice(1).toLowerCase(),
    status: getEventStatus(event),
    format: formatMap[event.format] || 'In-person',
    cost: event.cost ? costMap[event.cost] || 'Free' : 'Free',
    category: event.tags?.map((tag: any) => tag.tag) || [],
    bannerImage: event.bannerImageUrl,
    description: stripHtml(event.description || '') || '',
    address: event.address,
  };
}

let events: ReturnType<typeof mapEventSummary>[];
let totalEvents: number;
let totalPages: number;

if (!filtersActive) {
  const offset = (currentPage - 1) * PAGE_SIZE;
  const { data: apiEvents, meta } = await fetchEventSummaries({
    limit: PAGE_SIZE,
    offset,
  });
  totalEvents = meta?.count || 0;
  totalPages = Math.max(1, Math.ceil(totalEvents / PAGE_SIZE));
  events = (apiEvents || []).map(mapEventSummary);
} else {
  const allSummaries = await fetchAllEventSummaries();
  const filtered = filterEvents(
    allSummaries.map(mapEventSummary),
    activeFilters
  );
  totalEvents = filtered.length;
  totalPages = Math.max(1, Math.ceil(totalEvents / PAGE_SIZE));
  const safePage = Math.min(currentPage, totalPages);
  const offset = (safePage - 1) * PAGE_SIZE;
  events = filtered.slice(offset, offset + PAGE_SIZE);
}

if (totalEvents > 0 && currentPage > totalPages) {
  const redirectParams = serializeEventFilters(activeFilters);
  if (totalPages > 1) redirectParams.set('page', String(totalPages));
  const query = redirectParams.toString();
  return Astro.redirect(`/events${query ? `?${query}` : ''}`, 302);
}
---

<BaseLayout title="Events | Nepal Climate Hub"
  description="Find upcoming and past climate events, conferences and workshops in Nepal, from local youth gatherings to national conferences.">
  <main class="main-container">
    <section class="header-section">
      <Header logoColor="#1A1B1E" />

       	<Breadcrumbs
        		data={[
					  { label: "Events", href: "/events" },
				]}
      			/>
    </section>

    <div class="event-wrapper">
      <section class="filter-section">
        <CardFilterSection heading="Events" type="event" filter="false" />
      </section>

      <section class="event-cards-section">
        <EventFilter
          client:load
          events={events}
          currentPage={currentPage}
          pageSize={PAGE_SIZE}
          totalEvents={totalEvents}
          totalPages={totalPages}
          activeFilters={activeFilters}
        />
      </section>
    </div>

    <section class="footer-section">
      <Footer />
    </section>
  </main>
</BaseLayout>

<style>
  section {
    padding: 0px 48px;
  }

  .page-title {
    font-size: 32px;
    line-height: 60px;
    font-weight: 700;
  }

  .page-tagline {
    line-height: 24px;
    margin-bottom: 48px;
  }

  .event-wrapper {
    background-color: #ebf1f7;
  }

  .footer-section {
    background-color: #1a1b1e;
    color: white;
  }

  @media screen and (max-width: 768px) {
    section {
      padding: 0px;
    }

    .event-cards-section {
      padding: 0;
    }
  }
</style>
