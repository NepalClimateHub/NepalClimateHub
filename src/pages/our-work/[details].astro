---
import '../../styles/global.css';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import HtmlRenderer from '@components/HtmlRenderer.astro';
import ProjectCard from '@components/ProjectCard.astro';
import {
  RiArrowRightDoubleLine,
  RiCalendarLine,
  RiLayoutGridLine,
  RiTimeLine,
} from 'react-icons/ri';
import { fetchAllProjects, getProject } from '../../api';
import BaseLayout from '../../layouts/Layout.astro';
import type { Project } from '../../types/project';
import { createSlug } from '../../utils/slug';

const { details } = Astro.params;
let project: Project | undefined;
let otherProjects: Project[] = [];

if (!details) {
  return Astro.rewrite('/404');
}

try {
  project = await getProject(details);
} catch (error) {
  console.error('Error fetching project:', error);
}

if (!project) {
  return Astro.rewrite('/404');
}

try {
  const response = await fetchAllProjects();
  otherProjects = (response.data || [])
    .filter((p) => createSlug(p.title) !== details)
    .slice(0, 3);
} catch (error) {
  console.error('Error fetching other projects:', error);
}

const status = (project.status || '').toLowerCase().trim();
const projectType = project.tags?.length
  ? project.tags.map((t) => t.tag).join(', ')
  : '—';

const metaItems = [
  { Icon: RiTimeLine, label: 'Project Status', value: status || '—' },
  { Icon: RiLayoutGridLine, label: 'Project Type', value: projectType },
  { Icon: RiCalendarLine, label: 'Duration', value: project.duration || '—' },
];
---

<BaseLayout title={`${project.title} | Nepal Climate Hub`}>
  <main class="main-container">
    <section class="header-section">
      <Header logoColor="#1A1B1E" />
      <div class="mini-nav">
        <a href="/">Home</a>
        <span style="color: #364FC7"> / </span>
        <a href="/our-work">Our Work</a>
      </div>
    </section>

    <!-- Intro: title + description / image -->
    <section class="project-intro-section">
      <div class="section-container intro-grid">
        <div class="intro-text">
          <h1 class="project-title">{project.title}</h1>
          {project.overview && <p class="project-overview">{project.overview}</p>}
          <div class="project-description">
            <HtmlRenderer content={project.description} />
          </div>
        </div>

        <div class="intro-media">
          <img src={project.bannerImageUrl} alt={project.title} />
        </div>
      </div>
    </section>

    <!-- Meta bar -->
    <section class="project-meta-section">
      <div class="section-container meta-bar">
        {
          metaItems.map(({ Icon, label, value }) => (
            <div class="meta-item">
              <div class="meta-icon">
                <Icon aria-hidden="true" size={16} />
              </div>
              <div>
                <p class="meta-label">{label}</p>
                <p class="meta-value">{value}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Other Works -->
    {
      otherProjects.length > 0 && (
        <section class="other-works-section">
          <div class="section-container">
            <div class="other-works-header">
              <h2 class="section-title">Other Works</h2>
              <a href="/our-work" class="see-all">
                See All <RiArrowRightDoubleLine aria-hidden="true" size={14} />
              </a>
            </div>
            <div class="grid">
              {otherProjects.map((p) => (
                <ProjectCard project={p} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="footer-section">
      <Footer />
    </section>
  </main>
</BaseLayout>

<style>
  .header-section {
    padding: 0px 48px;
  }

  .crumb-current {
    font-size: 12px;
    line-height: 14px;
    color: #868e96;
  }

  /* Intro */
  .project-intro-section {
    padding: 32px 48px 40px;
    background-color: #ffffff;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .project-title {
    font-family: 'Zilla Slab', serif;
    font-size: 36px;
    line-height: 44px;
    font-weight: 700;
    color: #1a1b1e;
    margin: 0 0 20px;
  }

  .project-overview {
    font-size: 16px;
    line-height: 26px;
    font-weight: 500;
    color: #1a1b1e;
    margin: 0 0 16px;
  }

  .project-description {
    font-size: 15px;
    line-height: 24px;
    color: #464646;
  }

  .intro-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background-color: #f1f3f5;
  }

  .intro-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .media-tag {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 4px 12px;
    border-radius: 16px;
    background-color: #cefe00;
    color: #1a1b1e;
    font-size: 12px;
    font-weight: 600;
    text-transform: capitalize;
  }

  /* Meta bar */
  .project-meta-section {
    padding: 0 48px 48px;
    background-color: #ffffff;
  }

  .meta-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 20px 28px;
    background-color: #f8f9fa;
    border-radius: 12px;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .meta-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #cefe00;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #1a1b1e;
  }

  .meta-label {
    font-size: 13px;
    font-weight: 700;
    color: #1a1b1e;
    margin: 0 0 2px;
  }

  .meta-value {
    font-size: 13px;
    color: #464646;
    margin: 0;
    text-transform: capitalize;
  }

  /* Other works */
  .other-works-section {
    padding: 8px 48px 80px;
    background-color: #ffffff;
  }

  .other-works-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .section-title {
    font-size: 24px;
    line-height: 32px;
    font-weight: 700;
    color: #1a1b1e;
    margin: 0;
  }

  .see-all {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    font-weight: 600;
    color: #364fc7;
  }

  .see-all:hover {
    text-decoration: underline;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .footer-section {
    background-color: #1a1b1e;
    color: white;
  }

  /* Responsive */
  @media screen and (max-width: 1280px) {
    .project-intro-section {
      padding: 28px 24px 32px;
    }

    .project-meta-section {
      padding: 0 24px 40px;
    }

    .other-works-section {
      padding: 8px 24px 64px;
    }
  }

  @media screen and (max-width: 1024px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .intro-media {
      order: -1;
    }

    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .header-section {
      padding: 0px;
    }

    .project-intro-section {
      padding: 20px 24px 24px;
    }

    .project-title {
      font-size: 28px;
      line-height: 36px;
    }

    .meta-bar {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 20px;
    }

    .section-title {
      font-size: 22px;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
