---
// Mark this page as dynamic (not pre-rendered)
export const prerender = false;

import '../../styles/global.css';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import {
  fetchAllOpportunitySummaries,
  fetchOpportunitySummaries,
} from '../../api';
import logo from '../../assets/logo/secondaryLogo.svg';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import OpportunityFilter from '../../components/OpportunityFilter';
import CardFilterSection from '../../layouts/CardFilterSection.astro';
// import opportunitiesTemp from '../data/opportunitiesTemp.json';
import BaseLayout from '../../layouts/Layout.astro';
import { getOpportunityStatus } from '../../utils/listingStatus';
import type { OpportunitySummary } from '../../types/opportunity';
import {
  filterOpportunities,
  hasActiveOpportunityFilters,
  parseOpportunityFilters,
  serializeOpportunityFilters,
} from '../../utils/opportunityFilters';

const PAGE_SIZE = 8;
const requestedPage = Number.parseInt(
  Astro.url.searchParams.get('page') || '1',
  10
);
const currentPage =
  Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

const activeFilters = parseOpportunityFilters(Astro.url.searchParams);
const filtersActive = hasActiveOpportunityFilters(activeFilters);

function stripHtml(html: string) {
  return html.replace(/<[^>]*>/g, '');
}

function mapOpportunitySummary(opportunity: OpportunitySummary) {
  return {
    id: opportunity.id,
    title: opportunity.title,
    type: opportunity.type || '',
    locationType:
      opportunity.locationType.charAt(0).toUpperCase() +
      opportunity.locationType.slice(1).toLowerCase(),
    province: opportunity.address?.state || '',
    status: getOpportunityStatus(opportunity),
    format: opportunity.format || '',
    cost: opportunity.cost || '',
    organization: '',
    description: stripHtml(opportunity.description || '') || '',
    category: opportunity.tags?.map((tag) => tag.tag) || [],
    bannerImage: opportunity.bannerImageUrl || logo.src,
    applicationDeadline: '',
    duration: '',
    applicationDetail: '#',
    contactEmail: '',
    website: '',
    socials: { facebook: '', linkedin: '', instagram: '' },
    contributedBy: '',
  };
}

let opportunities: ReturnType<typeof mapOpportunitySummary>[];
let totalOpportunities: number;
let totalPages: number;

if (!filtersActive) {
  const offset = (currentPage - 1) * PAGE_SIZE;
  const { data: apiOpportunities, meta } = await fetchOpportunitySummaries({
    limit: PAGE_SIZE,
    offset,
  });
  totalOpportunities = meta?.count || 0;
  totalPages = Math.max(1, Math.ceil(totalOpportunities / PAGE_SIZE));
  opportunities = (apiOpportunities || []).map(mapOpportunitySummary);
} else {
  const allSummaries = await fetchAllOpportunitySummaries();
  const filtered = filterOpportunities(
    allSummaries.map(mapOpportunitySummary),
    activeFilters
  );
  totalOpportunities = filtered.length;
  totalPages = Math.max(1, Math.ceil(totalOpportunities / PAGE_SIZE));
  const safePage = Math.min(currentPage, totalPages);
  const offset = (safePage - 1) * PAGE_SIZE;
  opportunities = filtered.slice(offset, offset + PAGE_SIZE);
}

if (totalOpportunities > 0 && currentPage > totalPages) {
  const redirectParams = serializeOpportunityFilters(activeFilters);
  if (totalPages > 1) redirectParams.set('page', String(totalPages));
  const query = redirectParams.toString();
  return Astro.redirect(`/opportunities${query ? `?${query}` : ''}`, 302);
}
---

<BaseLayout title="Opportunities | Nepal Climate Hub"
  description="Browse fellowships, grants, jobs, volunteering and training opportunities for young climate leaders in Nepal.">
  <main class="main-container">
    <!-- Header Section -->
    <section class="header-section">
      <Header logoColor="#1A1B1E" />

      <Breadcrumbs
        data={[{ label: "Opportunities", href: "/opportunities" }]}
      />
    </section>

    <!-- Opportunity Section -->
    <div class="opportunity-wrapper">
      <section class="filter-section">
        <CardFilterSection
          heading="Opportunities"
          type="opportunity"
          filter={false}
        />
      </section>

      <section class="opportunity-cards-section">
        <OpportunityFilter
          client:load
          opportunities={opportunities}
          currentPage={currentPage}
          pageSize={PAGE_SIZE}
          totalOpportunities={totalOpportunities}
          totalPages={totalPages}
          activeFilters={activeFilters}
        />
      </section>
    </div>

    <!-- Footer Section -->
    <section class="footer-section">
      <Footer />
    </section>
  </main>
</BaseLayout>

<style>
  section {
    padding: 0px 48px;
  }

  .page-title {
    font-size: 32px;
    line-height: 60px;
    font-weight: 700;
  }

  .page-tagline {
    line-height: 24px;
    margin-bottom: 48px;
  }

  .opportunity-wrapper {
    background-color: #ebf1f7;
  }

  .footer-section {
    background-color: #1a1b1e;
    color: white;
  }

  @media screen and (max-width: 768px) {
    section {
      padding: 0px;
    }

    .opportunity-cards-section {
      padding: 0;
    }
  }
</style>
