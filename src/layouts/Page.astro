---
import ActivistSection from '@components/ActivistSection.astro';
import CtaSection from '@components/CtaSection.astro';
import FactSection from '@components/FactSection.astro';
import FeaturedEventSection from '@components/FeaturedEventSection.astro';
import FeaturedNewsSection from '@components/FeaturedNewsSection.astro';
import FeaturedOrganizationSection from '@components/FeaturedOrganizationSection.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import HeroContent from '@components/HeroContent.astro';
import Testimonials from '@components/Testimonials.astro';
import heroImage from '../assets/homepage-hero-desktop.jpg';
import logo from '../assets/logo/mainLogo.svg';
import '../styles/global.css';

interface Props {
  title: string;
}

import FeaturedOpportunitySection from '@components/FeaturedOpportunitySection.astro';
// not used.
// import FeaturedBlogSection from "@components/FeaturedBlogSection.astro";
import BaseLayout from './Layout.astro';

const { title } = Astro.props;
const homepageFontStylesheet =
  'https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400;0,700;1,400&family=Zilla+Slab:wght@700&display=swap';
const siteUrl = Astro.site || 'https://nepalclimatehub.org';
const organizationJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Nepal Climate Hub',
  url: siteUrl,
  logo: new URL(logo.src, siteUrl).href,
  sameAs: [
    'https://www.linkedin.com/company/nepalclimatehub/',
    'https://www.instagram.com/nepalclimatehub',
    'https://www.facebook.com/nepalclimatehub',
  ],
}).replace(/</g, '\\u003c');
---

<BaseLayout
  title={title}
  preloadImage={heroImage.src}
  fontStylesheetHref={homepageFontStylesheet}
>
  <script type="application/ld+json" set:html={organizationJsonLd}></script>
  <div class="main-container home-shell">
    <div class="hero-header">
      <Header logoColor="white" />
    </div>

    <main class="home-main">
      <section class="hero-section">
        <HeroContent />
      </section>

      <section class="cta-section">
        <CtaSection />
      </section>

      <section class="fact-section">
        <FactSection />
      </section>

      <section class="activist-section">
        <ActivistSection startIndex="0" endIndex="4" title="Climate Champions" />
      </section>

      <section class="organization-section">
        <FeaturedOrganizationSection
          startIndex="0"
          endIndex="4"
          title="Organizations"
        />
      </section>

      <section class="event-section">
        <FeaturedEventSection startIndex="0" endIndex="4" title="Latest Events" />
      </section>

      <section class="opportunity-section">
        <FeaturedOpportunitySection
          startIndex="0"
          endIndex="4"
          title="New Opportunities"
        />
      </section>

      <section class="news-section">
        <FeaturedNewsSection />
      </section>

      <section class="!bg-gray-white">
        <Testimonials />
      </section>
    </main>

    <section class="footer-section">
      <Footer />
    </section>
  </div>
</BaseLayout>

<style>
  section,
  .hero-header {
    padding: 0px 48px;
  }

  .home-shell {
    position: relative;
    isolation: isolate;
  }

  .home-shell::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 488px;
    z-index: -1;
    background-image: url("../assets/homepage-hero-desktop.jpg");
    background-position: center;
    background-size: cover;
  }

  .home-main {
    display: flex;
    flex-direction: column;
  }

  /* 488px hero minus Header's outer height: 88px + 18px/18px margins */
  .hero-section {
    height: 364px;
  }

  @media screen and (min-width: 768px) {
    /* Header margins switch to 24px/32px here */
    .hero-section {
      height: 344px;
    }
  }

  .fact-section {
    background-color: #cefe00;
  }

  .organization-section,
  .opportunity-section,
  .blog-section {
    background-color: #ebf1f7;
  }

  .testimonial-section {
    background-color: #f8f9fa;
  }

  .footer-section {
    background-color: #1a1b1e;
    color: white;
  }

  @media screen and (max-width: 768px) {
    section,
    .hero-header {
      padding: 0px;
    }

    .home-shell::before {
      background-position: left;
    }
  }
</style>
